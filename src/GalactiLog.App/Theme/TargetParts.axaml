<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:detail="using:GalactiLog.App.ViewModels.TargetDetail">
    <!-- The disclosure chevron shared by the night header and the current layout. -->
    <StreamGeometry x:Key="IconChevronDown">M3,6 L8,11 L13,6</StreamGeometry>

    <!-- One filter swatch row, keyed once (phase review P2-3). The header's log line renders it.
         The Brush is a filter's own configured colour and is the one value on this page that is
         user data rather than a theme token. -->
    <DataTemplate x:Key="FilterSwatchTemplate" x:DataType="detail:FilterSwatchViewModel">
      <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
        <Ellipse Width="7" Height="7" Fill="{Binding Brush}" VerticalAlignment="Center" Margin="0,0,5,0" />
        <TextBlock Text="{Binding FilterName}" />
      </StackPanel>
    </DataTemplate>
</ResourceDictionary>
