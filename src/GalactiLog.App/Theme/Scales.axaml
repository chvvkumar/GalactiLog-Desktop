<ResourceDictionary xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Theme-independent scales (spec 14.4). Not per-theme; must not be redeclared per theme. -->
  <CornerRadius x:Key="RadiusSm">6</CornerRadius>
  <CornerRadius x:Key="RadiusMd">8</CornerRadius>
  <CornerRadius x:Key="RadiusLg">12</CornerRadius>

  <!-- The platform Fluent theme's own corner key, so a stock text box, combo box or check box
       takes the same 6 pixel corner as this application's buttons (spec 14.4). It lives here
       rather than in the six theme dictionaries because a radius is theme-independent, and it is
       an alias of RadiusSm rather than a second 6, so the scale stays the one place the value is
       written. Application.Resources is searched before FluentTheme's own dictionary, so this
       entry wins. -->
  <StaticResource x:Key="ControlCornerRadius" ResourceKey="RadiusSm" />

  <BoxShadows x:Key="ShadowSm">0 1 2 #4D000000</BoxShadows>
  <BoxShadows x:Key="ShadowMd">0 4 12 #66000000</BoxShadows>
  <BoxShadows x:Key="ShadowLg">0 8 24 #80000000</BoxShadows>

  <!-- The 4 pixel spacing scale (spec 14.4). Space* are uniform Thickness resources for a Margin
       or a Padding, SpaceGap* the same steps as doubles for a panel's Spacing. The steps are the
       web's own, 4, 8, 12, 16 and 24; a value off this scale in new or edited markup is a review
       finding. -->
  <Thickness x:Key="Space1">4</Thickness>
  <Thickness x:Key="Space2">8</Thickness>
  <Thickness x:Key="Space3">12</Thickness>
  <Thickness x:Key="Space4">16</Thickness>
  <Thickness x:Key="Space6">24</Thickness>
  <x:Double x:Key="SpaceGap1">4</x:Double>
  <x:Double x:Key="SpaceGap2">8</x:Double>
  <x:Double x:Key="SpaceGap3">12</x:Double>
  <x:Double x:Key="SpaceGap4">16</x:Double>
  <x:Double x:Key="SpaceGap6">24</x:Double>

  <!-- Ratios to root font size (spec 14.4), not pixel values. -->
  <x:Double x:Key="FontSizeMicro">0.500</x:Double>
  <x:Double x:Key="FontSizeTiny">0.643</x:Double>
  <x:Double x:Key="FontSizeCaption">0.714</x:Double>
  <x:Double x:Key="FontSizeLabel">0.786</x:Double>
</ResourceDictionary>
