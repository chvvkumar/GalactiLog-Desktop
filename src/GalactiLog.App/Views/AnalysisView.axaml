<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:analysis="using:GalactiLog.App.ViewModels.Analysis"
             xmlns:controls="using:GalactiLog.App.Controls"
             xmlns:queries="using:GalactiLog.Data.Queries"
             x:Class="GalactiLog.App.Views.AnalysisView"
             x:Name="Root"
             x:DataType="analysis:AnalysisViewModel">
  <!-- design-spec 12.14's four parts, top to bottom: the page heading, the shared filters card,
       the tab strip and the current tab's body, which sits in a card of its own.

       Theme/Controls.axaml classes only, theme tokens only, x:DataType on every template, no
       non-zero CornerRadius, and no local Button, Border.tag or Border.callout style anywhere in
       this file, which ControlStyleScanTest fails the build on. The containment is the shared
       Border.card (ui-polish Task 7). Nothing here sets a FontSize: Scales.axaml's FontSize* keys
       are ratios rather than point sizes (FontSizeTokenTest).

       ALL SEVEN help placements live in this one file (spec 12.14 Help topics): the
       page heading, the Shared filters heading and the five tab headings. A tab body view carries
       no heading row and no glyph, so all seven glyphs live here and touch no tab body file. -->
  <UserControl.Styles>
    <!-- Spec 12.14's "marks both in the error ink". One shared token and one ink setter on a
         TextBlock, which is the shape StatisticsView.axaml's own two local styles already take;
         no Button, Border.tag or Border.callout style is declared here, which is what
         ControlStyleScanTest fails the build on. The two CalendarDatePickers themselves keep the
         shipped control theme: restyling one would mean a control theme in a view, which is the
         breach this rule exists to stop, so it is their labels that carry the ink. -->
    <Style Selector="TextBlock.range-error">
      <Setter Property="Foreground" Value="{DynamicResource ColorError}" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <!-- Everything a tab section shows that is the BASE's and not the tab's own: the shared state
         sentence and its Retry. The mixed plate scale callout used to be here too and is now drawn
         once at the top of the page for the selected tab, so it is never repeated per tab.
         Written once rather than five times, which is the duplication design lesson 1 names; the inner
         ContentControl resolves the tab's own view through the App.axaml DataTemplate registered
         against its concrete type, which is the half each tab's own view fills.

         That ContentControl is drawn in EVERY state on purpose: the tab's view holds its pickers
         and its segments as well as its chart, so hiding it beside the state sentence would leave
         a reader who filtered the chart into emptiness with no control to filter back out of, and
         would make Compare, which starts unqueryable, unreachable. The chart half is gated inside
         the tab's own view by its one ResultRegion, bound to the base's ShowsResult. -->
    <DataTemplate x:Key="TabSectionTemplate" DataType="analysis:AnalysisTabViewModel">
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal"
                    Spacing="8"
                    IsVisible="{Binding StatusLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Text="{Binding StatusLine}"
                     Classes="t-caption"
                     TextWrapping="Wrap"
                     VerticalAlignment="Center" />
          <!-- Spec 12.14's States table: a failure is per tab, never per page, and the Retry is
               offered only in that state. -->
          <Button Classes="sm"
                  Content="Retry"
                  Command="{Binding RetryCommand}"
                  IsVisible="{Binding State,
                                      Converter={x:Static ObjectConverters.Equal},
                                      ConverterParameter={x:Static analysis:AnalysisTabState.Failed}}" />
        </StackPanel>
        <ContentControl Content="{Binding}" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,*" Margin="16">
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
      <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Classes="t-title" />
      <controls:HelpButton Topic="page.analysis" />
    </StackPanel>

    <!-- One ScrollViewer for the whole page, as Statistics has. The platform scrollbar is
         restyled, overlays and takes no layout space (spec 12), and horizontal scrolling is the
         ScrollViewer's own default of Disabled, which is what keeps ExtentWidth from passing
         ViewportWidth at either window size. WheelPassthrough: the tab views under it hold
         LiveCharts charts, which swallow a plain wheel; the scroller scrolls anyway, and Ctrl
         with the wheel is left to the chart. -->
    <ScrollViewer Grid.Row="1" controls:WheelPassthrough.IsEnabled="True">
      <StackPanel Spacing="16">

        <!-- Spec 12.14's mixed plate scale warning, once for the page: the warning callout
             composite of the control vocabulary, at the top and bound to the SELECTED tab's own
             answer, so it is never repeated per tab. Not a caption and not tertiary ink. The
             sentence is the base's one constant and is never respelled here. -->
        <ContentControl x:Name="PlateScaleWarning"
                        Classes="callout warn"
                        IsVisible="{Binding SelectedTab.PlateScaleWarningVisible}">
          <TextBlock Text="{x:Static analysis:AnalysisTabViewModel.PlateScaleWarningText}"
                     TextWrapping="Wrap" />
        </ContentControl>

        <!-- Shared filters, in one card. Its own heading carries the analysis.filters glyph. -->
        <Border x:Name="SharedFilters" Classes="card">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Shared filters" Classes="t-heading" VerticalAlignment="Center" />
            <controls:HelpButton Topic="analysis.filters" />
          </StackPanel>

          <!-- A WrapPanel and never one non-wrapping row: at the 960 by 720 minimum the content
               region is 760 to 912 wide (rail open or shut) and the five controls do not fit across it, and a clipped
               control hides an affordance the reader cannot then find. -->
          <WrapPanel x:Name="FilterControls">
            <StackPanel Spacing="2" Margin="0,0,12,8">
              <TextBlock Text="Equipment combination" Classes="t-caption" />
              <ComboBox x:Name="EquipmentPicker"
                        Width="230"
                        ItemsSource="{Binding SharedFilter.EquipmentChoices}"
                        SelectedItem="{Binding SharedFilter.SelectedEquipment, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="analysis:EquipmentChoice">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                      <!-- The grouped marker, spec 12.5's own: the literal the Statistics
                           equipment rows draw in tertiary ink, and the tooltip declared once on
                           EquipmentComboRowViewModel and aliased by SharedFilterViewModel. -->
                      <TextBlock Text="{x:Static analysis:SharedFilterViewModel.GroupedMarker}"
                                 VerticalAlignment="Center"
                                 IsVisible="{Binding Grouped}"
                                 Foreground="{DynamicResource ColorTextTertiary}"
                                 ToolTip.Tip="{x:Static analysis:SharedFilterViewModel.GroupedTooltip}" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <StackPanel Spacing="2" Margin="0,0,12,8">
              <TextBlock Text="Filter" Classes="t-caption" />
              <ComboBox x:Name="FilterPicker"
                        Width="160"
                        ItemsSource="{Binding SharedFilter.FilterChoices}"
                        SelectedItem="{Binding SharedFilter.SelectedFilter, Mode=TwoWay}" />
            </StackPanel>

            <!-- The granularity choice. Two Button.pill with selected on the chosen one, the same
                 pill group the tabs' smoothing, chart and mode choices take, so a choice never
                 looks like the tab strip below or like a command (ux-flow F7). No new class and
                 no local style. -->
            <StackPanel Spacing="2" Margin="0,0,12,8">
              <TextBlock Text="Granularity" Classes="t-caption" />
              <StackPanel Orientation="Horizontal">
                <Button x:Name="PerFrameButton"
                        Classes="pill"
                        Classes.selected="{Binding SharedFilter.IsPerFrame}"
                        Content="Per frame"
                        Command="{Binding SharedFilter.SelectGranularityCommand}"
                        CommandParameter="{x:Static queries:AnalysisGranularity.Frame}" />
                <Button x:Name="PerSessionButton"
                        Classes="pill"
                        Classes.selected="{Binding SharedFilter.IsPerSession}"
                        Content="Per session"
                        Command="{Binding SharedFilter.SelectGranularityCommand}"
                        CommandParameter="{x:Static queries:AnalysisGranularity.Session}" />
              </StackPanel>
            </StackPanel>

            <!-- One field per date with a calendar dropdown, in place of the three-part month, day
                 and year boxes (screenshot-compare section 4). A CalendarDatePicker has no clear
                 gesture of its own, so each bound date carries a quiet glyph button beside it. -->
            <StackPanel Spacing="2" Margin="0,0,12,8">
              <TextBlock Text="Date from"
                         Classes="t-caption"
                         Classes.range-error="{Binding SharedFilter.HasError}" />
              <StackPanel Orientation="Horizontal" Spacing="4">
                <CalendarDatePicker x:Name="DateFromPicker"
                                    Width="150"
                                    SelectedDate="{Binding SharedFilter.DateFrom, Mode=TwoWay}" />
                <Button x:Name="ClearDateFromButton"
                        Classes="chevron"
                        Command="{Binding SharedFilter.ClearDateFromCommand}"
                        VerticalAlignment="Center"
                        ToolTip.Tip="Clear"
                        AutomationProperties.Name="Clear date from">
                  <Path Classes="icon-glyph" Data="{StaticResource IconDismiss}" Width="16" Height="16" />
                </Button>
              </StackPanel>
            </StackPanel>

            <StackPanel Spacing="2" Margin="0,0,12,8">
              <TextBlock Text="Date to"
                         Classes="t-caption"
                         Classes.range-error="{Binding SharedFilter.HasError}" />
              <StackPanel Orientation="Horizontal" Spacing="4">
                <CalendarDatePicker x:Name="DateToPicker"
                                    Width="150"
                                    SelectedDate="{Binding SharedFilter.DateTo, Mode=TwoWay}" />
                <Button x:Name="ClearDateToButton"
                        Classes="chevron"
                        Command="{Binding SharedFilter.ClearDateToCommand}"
                        VerticalAlignment="Center"
                        ToolTip.Tip="Clear"
                        AutomationProperties.Name="Clear date to">
                  <Path Classes="icon-glyph" Data="{StaticResource IconDismiss}" Width="16" Height="16" />
                </Button>
              </StackPanel>
            </StackPanel>
          </WrapPanel>

          <!-- Spec 12.14's reversed range: the sentence UNDER the two fields, both fields in the
               error ink, and no query on any tab. The refusal to query is SharedFilterViewModel's
               own rule and not this markup's; this is only the half the reader sees. -->
          <ContentControl x:Name="DateRangeError"
                  Classes="callout error"
                  IsVisible="{Binding SharedFilter.HasError}">
            <TextBlock Text="{x:Static analysis:SharedFilterViewModel.RangeErrorText}"
                       TextWrapping="Wrap" />
          </ContentControl>
        </StackPanel>
        </Border>

        <!-- The tab strip, its own part below the filter card: the shared ListBox.tabs, an accent
             underline on the selected tab, so navigation never looks like the pager or a command
             (ux-flow F7). The selection is the page's own SelectedTab, two-way, and AlwaysSelected
             keeps a ctrl-click from leaving the page with no tab; AnalysisViewTests pins the
             selection moving the body through the real view. -->
        <ListBox x:Name="TabStrip"
                 Classes="tabs"
                 ItemsSource="{Binding Tabs}"
                 SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                 SelectionMode="AlwaysSelected"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="analysis:AnalysisTabViewModel">
              <TextBlock Text="{Binding Title}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- The five tab sections, each a card its chart fills (Controls/FillViewport.cs). Each
             carries its own heading row, which is where its glyph goes, and its body below; only
             the selected tab's section is shown. -->
        <Border x:Name="CorrelationSection" Classes="card" IsVisible="{Binding Tabs[0].IsVisible}">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Correlation" Classes="t-heading" VerticalAlignment="Center" />
              <controls:HelpButton Topic="analysis.correlation" />
            </StackPanel>
            <ContentControl Content="{Binding Tabs[0]}" ContentTemplate="{StaticResource TabSectionTemplate}" />
          </StackPanel>
        </Border>

        <Border x:Name="DistributionsSection" Classes="card" IsVisible="{Binding Tabs[1].IsVisible}">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Distributions" Classes="t-heading" VerticalAlignment="Center" />
              <controls:HelpButton Topic="analysis.distributions" />
            </StackPanel>
            <ContentControl Content="{Binding Tabs[1]}" ContentTemplate="{StaticResource TabSectionTemplate}" />
          </StackPanel>
        </Border>

        <Border x:Name="TimeSeriesSection" Classes="card" IsVisible="{Binding Tabs[2].IsVisible}">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Time series" Classes="t-heading" VerticalAlignment="Center" />
              <controls:HelpButton Topic="analysis.timeseries" />
            </StackPanel>
            <ContentControl Content="{Binding Tabs[2]}" ContentTemplate="{StaticResource TabSectionTemplate}" />
          </StackPanel>
        </Border>

        <Border x:Name="MatrixSection" Classes="card" IsVisible="{Binding Tabs[3].IsVisible}">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Matrix" Classes="t-heading" VerticalAlignment="Center" />
              <controls:HelpButton Topic="analysis.matrix" />
            </StackPanel>
            <ContentControl Content="{Binding Tabs[3]}" ContentTemplate="{StaticResource TabSectionTemplate}" />
          </StackPanel>
        </Border>

        <Border x:Name="CompareSection" Classes="card" IsVisible="{Binding Tabs[4].IsVisible}">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Compare" Classes="t-heading" VerticalAlignment="Center" />
              <controls:HelpButton Topic="analysis.compare" />
            </StackPanel>
            <ContentControl Content="{Binding Tabs[4]}" ContentTemplate="{StaticResource TabSectionTemplate}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
