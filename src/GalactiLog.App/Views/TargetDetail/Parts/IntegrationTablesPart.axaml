<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:parts="using:GalactiLog.App.Views.TargetDetail.Parts"
             xmlns:detail="using:GalactiLog.App.ViewModels.TargetDetail"
             x:Class="GalactiLog.App.Views.TargetDetail.Parts.IntegrationTablesPart"
             x:Name="Root"
             x:DataType="detail:TargetDetailViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="MatrixRowTemplate" x:DataType="detail:MatrixRowViewModel">
      <Grid MinHeight="26">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock MinWidth="{Binding $parent[UserControl].FontSize, Converter={x:Static parts:FontScale.Instance}, ConverterParameter=117}" Padding="6,0,0,0" VerticalAlignment="Center" Text="{Binding Label}" />
        <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Width="{Binding $parent[UserControl].FontSize, Converter={x:Static parts:FontScale.Instance}, ConverterParameter=64}" Classes="num" Padding="0,0,6,0" VerticalAlignment="Center" Text="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Grid.Column="2" Width="{Binding $parent[UserControl].FontSize, Converter={x:Static parts:FontScale.Instance}, ConverterParameter=64}" Classes="num" Padding="0,0,6,0" VerticalAlignment="Center" Text="{Binding Total}" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="MatrixHeaderTemplate" x:DataType="detail:NightFilterMatrixViewModel">
      <ItemsControl ItemsSource="{Binding Filters}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="detail:FilterSwatchViewModel">
            <TextBlock Width="{Binding $parent[UserControl].FontSize, Converter={x:Static parts:FontScale.Instance}, ConverterParameter=64}"
                       Classes="t-label num"
                       Padding="0,0,6,0"
                       Text="{Binding FilterName}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding FilterName}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DataTemplate>
  </UserControl.Resources>

  <!-- Frames by exposure length, then hours by night. Filter columns of 64 px and a
       label column as wide as its widest label (never under 117 px), both widened with the text size, shared by both tables, inside one scroll viewer, so the filter columns line
       up and a wide set of filters scrolls both together. -->
  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
    <StackPanel Spacing="16" Grid.IsSharedSizeScope="True" IsVisible="{Binding NightFilterMatrix.HasRows, FallbackValue=False}">
      <StackPanel x:Name="ExposureTable">
        <Grid MinHeight="20">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock MinWidth="{Binding $parent[UserControl].FontSize, Converter={x:Static parts:FontScale.Instance}, ConverterParameter=117}" Classes="t-label" Padding="6,0,0,0" Text="Frames by exposure" />
          <ContentControl Grid.Column="1" Content="{Binding NightFilterMatrix}" ContentTemplate="{StaticResource MatrixHeaderTemplate}" />
          <TextBlock Grid.Column="2" Width="{Binding $parent[UserControl].FontSize, Converter={x:Static parts:FontScale.Instance}, ConverterParameter=64}" Classes="t-label num" Padding="0,0,6,0" Text="Total" />
        </Grid>
        <ItemsControl ItemsSource="{Binding NightFilterMatrix.ExposureRows}"
                      ItemTemplate="{StaticResource MatrixRowTemplate}" />
        <ContentControl Content="{Binding NightFilterMatrix.ExposureTotalRow}"
                        ContentTemplate="{StaticResource MatrixRowTemplate}" />
      </StackPanel>

      <StackPanel x:Name="HoursTable">
        <Grid MinHeight="20">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock MinWidth="{Binding $parent[UserControl].FontSize, Converter={x:Static parts:FontScale.Instance}, ConverterParameter=117}" Classes="t-label" Padding="6,0,0,0" Text="Hours by night" />
          <ContentControl Grid.Column="1" Content="{Binding NightFilterMatrix}" ContentTemplate="{StaticResource MatrixHeaderTemplate}" />
          <TextBlock Grid.Column="2" Width="{Binding $parent[UserControl].FontSize, Converter={x:Static parts:FontScale.Instance}, ConverterParameter=64}" Classes="t-label num" Padding="0,0,6,0" Text="Total" />
        </Grid>
        <ItemsControl ItemsSource="{Binding NightFilterMatrix.HoursRows}"
                      ItemTemplate="{StaticResource MatrixRowTemplate}" />
        <ContentControl Content="{Binding NightFilterMatrix.HoursTotalRow}"
                        ContentTemplate="{StaticResource MatrixRowTemplate}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
