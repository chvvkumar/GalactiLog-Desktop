<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:detail="using:GalactiLog.App.ViewModels.TargetDetail"
             xmlns:conv="using:GalactiLog.App.Converters"
             xmlns:t="using:GalactiLog.App.Controls.Table"
             x:Class="GalactiLog.App.Views.TargetDetail.Parts.RangesTablePart"
             x:Name="Root"
             x:DataType="detail:SessionCardViewModel">
  <UserControl.Resources>
    <!-- The ranges bar positions its tick with this, over a fixed track, which is why the pane
         needs no new converter and no GridLength binding. -->
    <conv:MultiplyConverter x:Key="Multiply" />

    <t:TableColumns x:Key="RangeCols" Id="Range">
      <t:TableColumn Key="label" MinWidth="100" />
      <t:TableColumn Key="min" Kind="Number" MinWidth="66" />
      <t:TableColumn Key="median" Kind="Number" MinWidth="74" />
      <t:TableColumn Key="max" Kind="Number" MinWidth="66" />
      <t:TableColumn Key="bar" />
      <t:TableColumn Key="spare" Width="*" />
    </t:TableColumns>
  </UserControl.Resources>

  <UserControl.Styles>
    <StyleInclude Source="/Views/TargetDetail/Parts/PartStyles.axaml" />
  </UserControl.Styles>

  <!-- Spec 12.4's session ranges. Median sits between Min and Max, which is where it sits on
       the number line, and the bar at the end shows the skew: a median near the minimum with a
       long tail to the maximum is the signature of a night with a few bad frames. -->
  <StackPanel x:Name="RangesTable" Grid.IsSharedSizeScope="True">
    <t:TableRow x:Name="RangesTableHeader" Kind="Header" Columns="{StaticResource RangeCols}">
      <TextBlock t:TableRow.Col="label" Text="Range" />
      <TextBlock t:TableRow.Col="min" Text="Min" />
      <TextBlock t:TableRow.Col="median" Text="Median" />
      <TextBlock t:TableRow.Col="max" Text="Max" />
    </t:TableRow>

    <ItemsControl x:Name="RangeRowsList" Classes="table" ItemsSource="{Binding Ranges}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="detail:RangeCellViewModel">
          <Panel>
            <t:TableRow Columns="{StaticResource RangeCols}" IsVisible="{Binding !IsRigLabel}">
              <!-- A row heading, not a header row, so it keeps the secondary ink. -->
              <TextBlock t:TableRow.Col="label"
                         Text="{Binding Label}"
                         Foreground="{DynamicResource ColorTextSecondary}" />
              <TextBlock t:TableRow.Col="min" Text="{Binding MinText}" />
              <TextBlock t:TableRow.Col="median" Text="{Binding MedianText}" />
              <TextBlock t:TableRow.Col="max" Text="{Binding MaxText}" />
              <Canvas t:TableRow.Col="bar"
                      Width="72"
                      Height="12"
                      HorizontalAlignment="Left"
                      IsVisible="{Binding HasPosition}">
                <Rectangle Canvas.Top="5"
                           Width="72"
                           Height="2"
                           Fill="{DynamicResource ColorBorderEmphasis}" />
                <Rectangle Canvas.Top="0"
                           Canvas.Left="{Binding MedianPosition, Converter={StaticResource Multiply}, ConverterParameter=70}"
                           Width="2"
                           Height="12"
                           Fill="{DynamicResource ColorTextPrimary}" />
              </Canvas>
            </t:TableRow>

            <!-- Spec 12.4 item 2's rig label row, shown instead of the TableRow above, on the
                 per-filter table's rule and with its shared RigLabelRowTemplate. -->
            <ContentControl x:Name="RangeRigLabelRow"
                            Content="{Binding LabelRow}"
                            ContentTemplate="{StaticResource RigLabelRowTemplate}"
                            IsVisible="{Binding IsRigLabel}"
                            Margin="{x:Static t:TableMetrics.CellPadding}"
                            MinHeight="{x:Static t:TableMetrics.RowMinHeight}"
                            VerticalContentAlignment="Center" />
          </Panel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
