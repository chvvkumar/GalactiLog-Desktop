<parts:NightFilterTablePart xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="using:GalactiLog.App.Controls.Table"
             xmlns:parts="using:GalactiLog.App.Views.TargetDetail.Parts"
             xmlns:detail="using:GalactiLog.App.ViewModels.TargetDetail"
             x:Class="GalactiLog.App.Views.TargetDetail.Parts.CompareTablePart"
             x:Name="Root"
             x:DataType="detail:TargetDetailViewModel">
  <parts:NightFilterTablePart.Resources>
    <t:TableColumns x:Key="CompareCols" Id="Compare">
      <t:TableColumn Key="night" />
      <t:TableColumn Key="filter" MaxWidth="160" />
      <t:TableColumn Key="hfr" Kind="Number" />
      <t:TableColumn Key="ecc" Kind="Number" />
      <t:TableColumn Key="fwhm" Kind="Number" />
      <t:TableColumn Key="rms" Kind="Number" />
      <t:TableColumn Key="stars" Kind="Number" />
      <t:TableColumn Key="spare" Width="*" />
    </t:TableColumns>
  </parts:NightFilterTablePart.Resources>

  <!-- Nights as rows, newest first as the night list orders them, one row per filter the night
       shot and one zebra band per night; the five medians as columns. The header stays put above a
       scroller that moves the rows vertically only, under an always shown table bar. A night
       whose frames carry no filter is one "All frames" row of the night's own medians.

       ponytail: the rows are unvirtualised, fine for tens of nights times a handful of filters;
       switch to a ListBox if a target passes a few hundred rows. -->
  <Grid x:Name="CompareTable"
        RowDefinitions="Auto,*"
        Grid.IsSharedSizeScope="True"
        IsVisible="{Binding NightFilterMatrix.HasCompareRows, FallbackValue=False}">
    <t:TableRow Kind="Header" Columns="{StaticResource CompareCols}">
      <TextBlock t:TableRow.Col="night" Text="{x:Static t:TableHeads.Night}" />
      <TextBlock t:TableRow.Col="filter" Text="{x:Static t:TableHeads.Filter}" ToolTip.Tip="{x:Static t:TableHeads.Filter}" />
      <TextBlock t:TableRow.Col="hfr" Text="{x:Static t:TableHeads.Hfr}" ToolTip.Tip="{x:Static t:TableHeads.HfrTip}" />
      <TextBlock t:TableRow.Col="ecc" Text="{x:Static t:TableHeads.Ecc}" ToolTip.Tip="{x:Static t:TableHeads.EccTip}" />
      <TextBlock t:TableRow.Col="fwhm" Text="{x:Static t:TableHeads.Fwhm}" ToolTip.Tip="{x:Static t:TableHeads.FwhmTip}" />
      <TextBlock t:TableRow.Col="rms" Text="{x:Static t:TableHeads.Rms}" ToolTip.Tip="{x:Static t:TableHeads.RmsTip}" />
      <TextBlock t:TableRow.Col="stars" Text="{x:Static t:TableHeads.Stars}" />
    </t:TableRow>

    <ScrollViewer Grid.Row="1"
                  x:Name="CompareScroll"
                  t:Table.Scroller="True"
                  VerticalScrollBarVisibility="Visible"
                  HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="CompareRowList" ItemsSource="{Binding NightFilterMatrix.CompareRows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="detail:CompareRowViewModel">
            <t:TableRow Columns="{StaticResource CompareCols}" Classes.alt="{Binding IsAltGroup}">
              <TextBlock t:TableRow.Col="night" Text="{Binding NightText}" />
              <DockPanel t:TableRow.Col="filter" ToolTip.Tip="{Binding Metrics.Label}">
                <Ellipse DockPanel.Dock="Left"
                         Width="7"
                         Height="7"
                         Margin="0,0,5,0"
                         VerticalAlignment="Center"
                         Fill="{Binding Filter.Brush}" />
                <TextBlock Text="{Binding Metrics.Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </DockPanel>
              <TextBlock t:TableRow.Col="hfr" Text="{Binding Metrics.HfrText}" />
              <TextBlock t:TableRow.Col="ecc" Text="{Binding Metrics.EccentricityText}" />
              <TextBlock t:TableRow.Col="fwhm" Text="{Binding Metrics.FwhmText}" />
              <TextBlock t:TableRow.Col="rms" Text="{Binding Metrics.GuidingRmsText}" />
              <TextBlock t:TableRow.Col="stars" Text="{Binding Metrics.DetectedStarsText}" />
            </t:TableRow>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</parts:NightFilterTablePart>
