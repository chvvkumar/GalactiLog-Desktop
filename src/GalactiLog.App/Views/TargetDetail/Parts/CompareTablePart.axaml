<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:parts="using:GalactiLog.App.Views.TargetDetail.Parts"
             xmlns:detail="using:GalactiLog.App.ViewModels.TargetDetail"
             x:Class="GalactiLog.App.Views.TargetDetail.Parts.CompareTablePart"
             x:Name="Root"
             x:DataType="detail:TargetDetailViewModel">
  <!-- One row per filter, one column group per night of the five medians at 64, 52, 62, 57
       and 54 px (289 px a night). The filter column is pinned; the groups scroll sideways.
       Widths and heights grow with the text size and stay exact so the pinned rows match. -->
  <Grid x:Name="CompareTable"
        ColumnDefinitions="110,*"
        IsVisible="{Binding NightFilterMatrix.HasRows, FallbackValue=False}">
    <StackPanel Grid.Column="0">
      <TextBlock Height="{Binding $parent[UserControl].FontSize, Converter={x:Static parts:FontScale.Instance}, ConverterParameter=20}" />
      <TextBlock Height="{Binding $parent[UserControl].FontSize, Converter={x:Static parts:FontScale.Instance}, ConverterParameter=20}" Classes="t-label" Text="Filter" />
      <ItemsControl ItemsSource="{Binding NightFilterMatrix.CompareRows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="detail:CompareRowViewModel">
            <StackPanel Height="{Binding $parent[UserControl].FontSize, Converter={x:Static parts:FontScale.Instance}, ConverterParameter=26}" Orientation="Horizontal">
              <Ellipse Width="7"
                       Height="7"
                       Margin="0,0,5,0"
                       VerticalAlignment="Center"
                       Fill="{Binding Filter.Brush}" />
              <TextBlock Text="{Binding Filter.FilterName}"
                         MaxWidth="{Binding $parent[UserControl].FontSize, Converter={x:Static parts:FontScale.Instance}, ConverterParameter=90}"
                         TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <ScrollViewer Grid.Column="1"
                  x:Name="CompareScroll"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Disabled">
      <StackPanel>
        <ItemsControl x:Name="CompareNightHeaders" ItemsSource="{Binding NightFilterMatrix.CompareNights}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="detail:CompareNightViewModel">
              <StackPanel Width="{Binding $parent[UserControl].FontSize, Converter={x:Static parts:FontScale.Instance}, ConverterParameter=289}">
                <TextBlock Height="{Binding $parent[UserControl].FontSize, Converter={x:Static parts:FontScale.Instance}, ConverterParameter=20}" Classes="t-label" Padding="6,0,0,0" Text="{Binding Label}" />
                <StackPanel Height="{Binding $parent[UserControl].FontSize, Converter={x:Static parts:FontScale.Instance}, ConverterParameter=20}" Orientation="Horizontal">
                  <TextBlock Width="{Binding $parent[UserControl].FontSize, Converter={x:Static parts:FontScale.Instance}, ConverterParameter=64}" Classes="t-label num" Padding="0,0,6,0" Text="HFR px" />
                  <TextBlock Width="{Binding $parent[UserControl].FontSize, Converter={x:Static parts:FontScale.Instance}, ConverterParameter=52}" Classes="t-label num" Padding="0,0,6,0" Text="Ecc" />
                  <TextBlock Width="{Binding $parent[UserControl].FontSize, Converter={x:Static parts:FontScale.Instance}, ConverterParameter=62}" Classes="t-label num" Padding="0,0,6,0" Text="FWHM &quot;" />
                  <TextBlock Width="{Binding $parent[UserControl].FontSize, Converter={x:Static parts:FontScale.Instance}, ConverterParameter=57}" Classes="t-label num" Padding="0,0,6,0" Text="RMS &quot;" />
                  <TextBlock Width="{Binding $parent[UserControl].FontSize, Converter={x:Static parts:FontScale.Instance}, ConverterParameter=54}" Classes="t-label num" Padding="0,0,6,0" Text="Stars" />
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl x:Name="CompareRowList" ItemsSource="{Binding NightFilterMatrix.CompareRows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="detail:CompareRowViewModel">
              <ItemsControl ItemsSource="{Binding Cells}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="detail:CompareCellViewModel">
                    <StackPanel Width="{Binding $parent[UserControl].FontSize, Converter={x:Static parts:FontScale.Instance}, ConverterParameter=289}" Height="{Binding $parent[UserControl].FontSize, Converter={x:Static parts:FontScale.Instance}, ConverterParameter=26}" Orientation="Horizontal">
                      <TextBlock Width="{Binding $parent[UserControl].FontSize, Converter={x:Static parts:FontScale.Instance}, ConverterParameter=64}" Classes="num" Padding="0,0,6,0" VerticalAlignment="Center" Text="{Binding Hfr}" />
                      <TextBlock Width="{Binding $parent[UserControl].FontSize, Converter={x:Static parts:FontScale.Instance}, ConverterParameter=52}" Classes="num" Padding="0,0,6,0" VerticalAlignment="Center" Text="{Binding Eccentricity}" />
                      <TextBlock Width="{Binding $parent[UserControl].FontSize, Converter={x:Static parts:FontScale.Instance}, ConverterParameter=62}" Classes="num" Padding="0,0,6,0" VerticalAlignment="Center" Text="{Binding Fwhm}" />
                      <TextBlock Width="{Binding $parent[UserControl].FontSize, Converter={x:Static parts:FontScale.Instance}, ConverterParameter=57}" Classes="num" Padding="0,0,6,0" VerticalAlignment="Center" Text="{Binding GuidingRms}" />
                      <TextBlock Width="{Binding $parent[UserControl].FontSize, Converter={x:Static parts:FontScale.Instance}, ConverterParameter=54}" Classes="num" Padding="0,0,6,0" VerticalAlignment="Center" Text="{Binding DetectedStars}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
