<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Shared text classes of the target detail parts. -->
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource ColorTextTertiary}" />
  </Style>
  <Style Selector="TextBlock.disclosure">
    <Setter Property="Foreground" Value="{DynamicResource ColorTextTertiary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
</Styles>
