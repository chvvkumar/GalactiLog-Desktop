<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:detail="using:GalactiLog.App.ViewModels.TargetDetail"
             xmlns:controls="using:GalactiLog.App.Controls"
             x:Class="GalactiLog.App.Views.TargetDetail.Parts.NightTimelinePart"
             x:Name="Root"
             x:DataType="detail:SessionCardViewModel"
             IsVisible="{Binding HasNightStrip}">
  <!-- The night's signature graphic, absent before the first load rather than drawn empty; the
       root repeats the condition so the host's margin is not reserved for an absent strip. -->
  <ContentControl x:Name="NightStripRegion"
                  Content="{Binding NightStrip}"
                  IsVisible="{Binding HasNightStrip}">
    <ContentControl.ContentTemplate>
      <DataTemplate DataType="detail:NightStripViewModel">
        <controls:NightStrip Model="{Binding}"
                             LaneAxis="{Binding $parent[UserControl].((detail:SessionCardViewModel)DataContext).LaneAxis}"
                             Height="72"
                             TextElement.FontFamily="{StaticResource FontMono}"
                             BandBrush="{DynamicResource ColorBorderDefault}"
                             AxisBrush="{DynamicResource ColorBorderEmphasis}"
                             LabelBrush="{DynamicResource ColorTextTertiary}"
                             FirstLastLabelBrush="{DynamicResource ColorTextSecondary}"
                             OutlierBrush="{DynamicResource ColorMetricWorst}"
                             ActiveBrush="{DynamicResource ColorTextPrimary}" />
      </DataTemplate>
    </ContentControl.ContentTemplate>
  </ContentControl>
</UserControl>
