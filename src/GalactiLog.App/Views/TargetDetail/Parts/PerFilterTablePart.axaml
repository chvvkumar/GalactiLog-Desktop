<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:detail="using:GalactiLog.App.ViewModels.TargetDetail"
             xmlns:t="using:GalactiLog.App.Controls.Table"
             x:Class="GalactiLog.App.Views.TargetDetail.Parts.PerFilterTablePart"
             x:Name="Root"
             x:DataType="detail:SessionCardViewModel">

  <UserControl.Styles>
    <StyleInclude Source="/Views/TargetDetail/Parts/PartStyles.axaml" />
  </UserControl.Styles>

  <UserControl.Resources>
    <!-- The minimums keep the table's width steady from night to night inside the Session
         metrics wrap panel. -->
    <t:TableColumns x:Key="FilterCols" Id="Filter">
      <t:TableColumn Key="name" MinWidth="114" />
      <t:TableColumn Key="hfr" Kind="Number" MinWidth="82" />
      <t:TableColumn Key="ecc" Kind="Number" MinWidth="70" />
      <t:TableColumn Key="fwhm" Kind="Number" MinWidth="82" />
      <t:TableColumn Key="rms" Kind="Number" MinWidth="70" />
      <t:TableColumn Key="stars" Kind="Number" MinWidth="74" />
      <t:TableColumn Key="exp" Kind="Number" MinWidth="74" />
      <t:TableColumn Key="frames" Kind="Number" MinWidth="78" />
      <t:TableColumn Key="hours" Kind="Number" MinWidth="74" />
      <t:TableColumn Key="spare" Width="*" />
    </t:TableColumns>
  </UserControl.Resources>

  <!-- Spec 12.4's per-filter medians and per-filter detail rows as one table, joined by filter
       name, so one filter's figures are read in one place instead of the same filter list
       twice 400 pixels apart. A filter shot at more than one exposure keeps its sub-rows. -->
  <StackPanel x:Name="FilterTable" Grid.IsSharedSizeScope="True">
    <t:TableRow x:Name="FilterTableHeader" Kind="Header" Columns="{StaticResource FilterCols}">
      <TextBlock t:TableRow.Col="name" Text="Filter" />
      <TextBlock t:TableRow.Col="hfr" Text="{x:Static t:TableHeads.Hfr}" ToolTip.Tip="{x:Static t:TableHeads.HfrTip}" />
      <TextBlock t:TableRow.Col="ecc" Text="{x:Static t:TableHeads.Ecc}" ToolTip.Tip="{x:Static t:TableHeads.EccTip}" />
      <TextBlock t:TableRow.Col="fwhm" Text="{x:Static t:TableHeads.Fwhm}" ToolTip.Tip="{x:Static t:TableHeads.FwhmTip}" />
      <TextBlock t:TableRow.Col="rms" Text="{x:Static t:TableHeads.Rms}" ToolTip.Tip="{x:Static t:TableHeads.RmsTip}" />
      <TextBlock t:TableRow.Col="stars" Text="{x:Static t:TableHeads.Stars}" />
      <TextBlock t:TableRow.Col="exp" Text="{x:Static t:TableHeads.Exposure}" ToolTip.Tip="{x:Static t:TableHeads.ExposureTip}" />
      <TextBlock t:TableRow.Col="frames" Text="{x:Static t:TableHeads.Frames}" />
      <TextBlock t:TableRow.Col="hours" Text="{x:Static t:TableHeads.Hours}" />
    </t:TableRow>

    <ItemsControl x:Name="FilterRowsList" Classes="table" ItemsSource="{Binding FilterRows}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="detail:FilterTableRowViewModel">
          <Panel>
            <t:TableRow Columns="{StaticResource FilterCols}" IsVisible="{Binding !IsRigLabel}">
              <StackPanel t:TableRow.Col="name" Orientation="Horizontal" ToolTip.Tip="{Binding FilterName}">
                <Border Width="{x:Static t:TableMetrics.SubRowIndent}" IsVisible="{Binding IsSubRow}" />
                <Ellipse Width="7"
                         Height="7"
                         Margin="0,0,5,0"
                         VerticalAlignment="Center"
                         Fill="{Binding Swatch.Brush}"
                         IsVisible="{Binding Swatch, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Text="{Binding FilterName}" />
              </StackPanel>
              <TextBlock t:TableRow.Col="hfr" Text="{Binding MedianHfrText}" />
              <TextBlock t:TableRow.Col="ecc" Text="{Binding MedianEccentricityText}" />
              <TextBlock t:TableRow.Col="fwhm" Text="{Binding MedianFwhmText}" />
              <TextBlock t:TableRow.Col="rms" Text="{Binding MedianGuidingRmsText}" />
              <TextBlock t:TableRow.Col="stars" Text="{Binding MedianDetectedStarsText}" />
              <TextBlock t:TableRow.Col="exp"
                         Classes.muted="{Binding IsExposureCount}"
                         Text="{Binding ExposureTimeText}" />
              <TextBlock t:TableRow.Col="frames" Text="{Binding FrameCountText}" />
              <TextBlock t:TableRow.Col="hours" Text="{Binding IntegrationText}" />
            </t:TableRow>

            <!-- Spec 12.4 item 2's rig label row, on a multi-rig night only: shown instead of the
                 TableRow above. RigLabelRowTemplate is shared with the ranges table. -->
            <ContentControl x:Name="FilterRigLabelRow"
                            Content="{Binding LabelRow}"
                            ContentTemplate="{StaticResource RigLabelRowTemplate}"
                            IsVisible="{Binding IsRigLabel}"
                            Margin="{x:Static t:TableMetrics.CellPadding}"
                            MinHeight="{x:Static t:TableMetrics.RowMinHeight}"
                            VerticalContentAlignment="Center" />
          </Panel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
