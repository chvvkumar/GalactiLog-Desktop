<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="using:System"
             xmlns:dash="using:GalactiLog.App.ViewModels.Dashboard"
             xmlns:wbpp="using:GalactiLog.App.ViewModels.TargetDetail.Wbpp"
             x:Class="GalactiLog.App.Views.TargetDetail.Wbpp.QualityPanelView"
             x:Name="Root"
             x:DataType="wbpp:QualityPanelViewModel">
  <!-- design-spec 12.13's quality filter: the chips toolbar above, the verdict table below.

       A header row and an ItemsControl rather than a DataGrid, for the reason ruling Q7 gave the
       dashboard and the frame table: no DataGrid package is pinned. There is no selection model
       here, so this is an ItemsControl and not the frame table's ListBox; the one interactive cell
       is the Copy check box, which is bound two way to the row.

       The header row and the rows are two Grids with the SAME ColumnDefinitions string, written
       out in both places. They are Grid star and pixel columns and NOT an Auto shared size group:
       Auto shared-size columns inside a scroller measure at infinite width and produce a row wider
       than its viewport, with no error and every layout case green, which is the rule
       Views/TargetDetail/TargetDetailView.axaml's own header comment records from Phase 12. The
       two strings have to stay equal, and QualityPanelViewTests'
       QualityPanelView_TheHeaderCells_ShareOneLeftEdgeWithTheRowCells is what fails if they drift.

       Nothing here sets FontSize. Scales.axaml's FontSize* keys are ratios, not point sizes, and
       FontSizeTokenTest fails the build on binding one to FontSize. Every colour is a theme token:
       this panel renders no user data colour, so there is no legitimate literal in this file.

       No Button, ToggleButton, tag or callout style is declared here; ControlStyleScanTest fails
       the build on one. The chips are Button.pill, the active chip's frame is Border.tag and the
       baseline segment is the shipped ToggleButton, all from Theme/Controls.axaml. -->
  <UserControl.Resources>
    <!-- The metric cell's two boxes. The value box is fixed and the mark box beside it is
         reserved on every cell, marked or not, which is spec 12.13's "a mark in a fixed trailing
         slot present on every cell, so the digits keep one right edge whether a row failed or
         not". The two sum to the 68 each metric column takes below. -->
    <sys:Double x:Key="QualityMetricValueWidth">56</sys:Double>
    <sys:Double x:Key="QualityMetricMarkWidth">12</sys:Double>

    <!-- The Night column's trailing clearance. The row scroller's themed vertical scrollbar is an
         overlay that takes no layout space (the Phase 14C rule TargetListView.axaml's own
         TableTrailingInset records), so with more rows than the scroller's ceiling the thumb draws
         over the trailing pixels of the last column. One value, used by the Night header and by
         the Night cell, so the label and the digits keep one right edge although only one of the
         two sits inside the scroller.

         The inset comes out of the column's own width, because the digits are right aligned: the
         Night column is 112 and the date is drawn in the 104 the inset leaves. That is the
         launched-app look's D1. At 86 the cell had 78 px for a string that measures 98.6 px in
         Atkinson Hyperlegible Next Regular at the shipped 18 px root, the same face and size the
         Nights ledger's own Night cell uses and the same measurement its markup records, so every
         row on the page read "2025-03-..." at the window's opening width. 112 is the Nights
         ledger's own floor (TargetDetailViewModel.NightColumnMinWidth on the wide ledger) and
         leaves the same class of headroom here, 5.4 px over 98.6 plus the 8 px inset, which these
         rows need for the same reason that ledger does: they are realised by a
         VirtualizingStackPanel and a row realised in a different measure pass can keep that
         pass's remainder. -->
    <Thickness x:Key="QualityNightInset">0,0,8,0</Thickness>

    <!-- One header cell: a button that sorts, showing the direction glyph on the active key. Copy
         is drawn as a plain label instead, because it is the one unsortable column (spec 12.13:
         "inclusion is a per-row decision, not a metric") and a button that ignores its own click
         teaches the wrong model. -->
    <DataTemplate x:Key="QualityHeaderCell" DataType="dash:ColumnViewModel">
      <Button Classes="header-cell"
              Classes.numeric="{Binding IsNumeric}"
              Command="{Binding #Root.((wbpp:QualityPanelViewModel)DataContext).SortByCommand}"
              CommandParameter="{Binding Key}"
              Background="Transparent"
              BorderThickness="0"
              Padding="4,2">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0"
                     Text="{Binding Title}"
                     FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource ColorTextSecondary}" />
          <TextBlock Grid.Column="1"
                     Text="{Binding SortGlyph}"
                     Margin="2,0,0,0"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource ColorAccent}" />
        </Grid>
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- The cell's layout role only. No Foreground setter here on purpose: a control level style
         beats an application level one, so setting the neutral ink here would win over the band
         classes below and over Theme/Controls.axaml's. A cell in the neutral band therefore takes
         the inherited ink, which is spec 12.4's "neutral, which is to say no mark". -->
    <Style Selector="TextBlock.qcell">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Spec 12.4's three band inks on a cell of this table, re declared in this host so they can
         win over the role style above, exactly as FrameTableView.axaml re declares them and for
         the same reason. They bind the same brushes Theme/Controls.axaml binds. -->
    <Style Selector="TextBlock.qcell.band-better">
      <Setter Property="Foreground" Value="{DynamicResource ColorSuccess}" />
    </Style>
    <Style Selector="TextBlock.qcell.band-watch">
      <Setter Property="Foreground" Value="{DynamicResource ColorWarning}" />
    </Style>
    <Style Selector="TextBlock.qcell.band-reject">
      <Setter Property="Foreground" Value="{DynamicResource ColorError}" />
    </Style>

    <!-- Spec 12.13: "A metric cell that failed a gate is drawn in the error ink with a mark in a
         fixed trailing slot". Last of the ink blocks on purpose: within one style host the later
         block wins at equal specificity, so the failure ink beats whatever band the cell is in,
         which is HANDOFF 5.2 item 22's first case (the view's own ink beats the application level
         band). -->
    <Style Selector="TextBlock.qcell.failed">
      <Setter Property="Foreground" Value="{DynamicResource ColorError}" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- Spec 12.13's verdict word. Only the copy verdict takes an ink (success): the word itself
         already says "Unmeasured" or "Exclude", so those two carry the inherited ink and no amber
         or red. A class of its own rather than the band ones, because a verdict is not a deviation
         and the two must stay separable if either changes. -->
    <Style Selector="TextBlock.verdict-copy">
      <Setter Property="Foreground" Value="{DynamicResource ColorSuccess}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,Auto">
    <!-- 1. The toolbar. -->
    <WrapPanel Grid.Row="0" x:Name="ChipsToolbar" Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
      <!-- Spec 12.13's master switch. It stays live while everything beside it goes inert, which
           is what lets the user turn the filter back on. -->
      <CheckBox x:Name="EnableFilters"
                Content="Enable filters"
                VerticalAlignment="Center"
                IsChecked="{Binding IsFilterEnabled, Mode=TwoWay}" />

      <!-- Everything except the master check box goes inert while the filter is off. -->
      <ItemsControl x:Name="Chips"
                    ItemsSource="{Binding Chips}"
                    IsEnabled="{Binding IsFilterEnabled}"
                    VerticalAlignment="Center">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="wbpp:ConstraintChipViewModel">
            <Panel>
              <!-- The ghost: absent, or held with its value still on it. Spec 12.13: clicking it
                   adds the constraint, or restores the held value rather than starting over. -->
              <Button x:Name="GhostChip"
                      Classes="pill sm"
                      Margin="0"
                      IsVisible="{Binding !IsActive}"
                      Content="{Binding GhostText}"
                      Command="{Binding EnableCommand}" />

              <!-- The active chip. Border.tag is the shared badge frame; no style is declared
                   here for it. -->
              <Border x:Name="ActiveChip" Classes="tag" IsVisible="{Binding IsActive}" Padding="6,2">
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}"
                             FontWeight="Medium"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource ColorAccent}" />
                  <ComboBox x:Name="Comparator"
                            ItemsSource="{Binding ComparatorOptions}"
                            SelectedItem="{Binding Comparator, Mode=TwoWay}"
                            AutomationProperties.Name="{Binding ComparatorAccessibleName}"
                            VerticalAlignment="Center"
                            MinWidth="96">
                    <ComboBox.ItemTemplate>
                      <DataTemplate DataType="wbpp:ComparatorOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBox x:Name="Threshold"
                           Width="72"
                           VerticalAlignment="Center"
                           Watermark="value"
                           AutomationProperties.Name="{Binding ThresholdAccessibleName}"
                           Text="{Binding ThresholdText, Mode=TwoWay}" />

                  <!-- Spec 12.13's three eccentricity presets, on the eccentricity chip alone.
                       Each sets the value and the comparator together and is lit only while it is
                       the current pair. -->
                  <ItemsControl x:Name="Presets"
                                ItemsSource="{Binding Presets}"
                                IsVisible="{Binding HasPresets}"
                                VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="4" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="wbpp:PresetOptionViewModel">
                        <Button Classes="pill sm"
                                Margin="0"
                                Classes.selected="{Binding IsActive}"
                                Content="{Binding Caption}"
                                CommandParameter="{Binding}"
                                Command="{Binding $parent[ItemsControl].((wbpp:ConstraintChipViewModel)DataContext).ApplyPresetCommand}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- Disables and never deletes (spec 12.13). -->
                  <Button x:Name="DisableChip"
                          Classes="quiet sm"
                          Content="&#x00D7;"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="{Binding DisableAccessibleName}"
                          Command="{Binding DisableCommand}" />
                </StackPanel>
              </Border>
            </Panel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Spec 12.13's tally, one line beside the chips. It counts every LIGHT frame of the
           checked nights, which is a wider set than the page footer's figures, and the footer's
           own sentence says so. -->
      <TextBlock x:Name="Tally"
                 Classes="t-caption num"
                 VerticalAlignment="Center"
                 Text="{Binding TallyText}" />

      <!-- Spec 12.13's baseline segment, on the shipped two button idiom (HANDOFF 5.2 item 23):
           two way over one settable bool and its negation, one source of truth, no Command. A one
           way binding plus a command cannot hold it, because a ToggleButton flips its own
           IsChecked through SetCurrentValue before the command runs and a one way binding whose
           source has not changed does not push it back, which left the whole segment dark. Its
           known consequence, that a click on the lit button switches to the other option, is
           accepted.

           "This rig" is the label spec 12.4's frame table already uses for the same baseline, in
           place of the web application's "Overall"; the stored value is unchanged. -->
      <StackPanel x:Name="BaselineSegment"
                  Orientation="Horizontal"
                  Spacing="4"
                  VerticalAlignment="Center"
                  IsEnabled="{Binding IsFilterEnabled}">
        <TextBlock Classes="t-label"
                   Text="Compare to"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource ColorTextTertiary}" />
        <ToggleButton x:Name="BaselineSession"
                      Content="This session"
                      ToolTip.Tip="This session builds the baselines from the selected night's own frames."
                      IsChecked="{Binding IsSessionBaseline, Mode=TwoWay}" />
        <ToggleButton x:Name="BaselineRig"
                      Content="This rig"
                      ToolTip.Tip="This rig builds them from every frame captured with the same telescope, camera and filter across the library, whatever the target."
                      IsChecked="{Binding !IsSessionBaseline, Mode=TwoWay}" />
      </StackPanel>
    </WrapPanel>

    <!-- 2. The header row. Its ColumnDefinitions string is repeated on the row Grid below and the
         two have to stay equal; see the file header. -->
    <Grid Grid.Row="1"
          x:Name="HeaderRow"
          Margin="0,8,0,0"
          IsVisible="{Binding HasFrames}"
          ColumnDefinitions="56,88,72,68,68,68,68,68,*,112">
      <TextBlock Grid.Column="0"
                 x:Name="CopyHeader"
                 Classes="t-label"
                 Text="Copy"
                 Margin="4,2"
                 TextAlignment="Center"
                 VerticalAlignment="Center" />
      <ContentControl Grid.Column="1" Content="{Binding Columns[1]}" ContentTemplate="{StaticResource QualityHeaderCell}" />
      <ContentControl Grid.Column="2" Content="{Binding Columns[2]}" ContentTemplate="{StaticResource QualityHeaderCell}" />
      <!-- The five metric headers give up the mark slot's width, so their label right aligns with
           the digits rather than with the slot. -->
      <ContentControl Grid.Column="3" Margin="0,0,12,0" Content="{Binding Columns[3]}" ContentTemplate="{StaticResource QualityHeaderCell}" />
      <ContentControl Grid.Column="4" Margin="0,0,12,0" Content="{Binding Columns[4]}" ContentTemplate="{StaticResource QualityHeaderCell}" />
      <ContentControl Grid.Column="5" Margin="0,0,12,0" Content="{Binding Columns[5]}" ContentTemplate="{StaticResource QualityHeaderCell}" />
      <ContentControl Grid.Column="6" Margin="0,0,12,0" Content="{Binding Columns[6]}" ContentTemplate="{StaticResource QualityHeaderCell}" />
      <ContentControl Grid.Column="7" Margin="0,0,12,0" Content="{Binding Columns[7]}" ContentTemplate="{StaticResource QualityHeaderCell}" />
      <ContentControl Grid.Column="8" Content="{Binding Columns[8]}" ContentTemplate="{StaticResource QualityHeaderCell}" />
      <ContentControl Grid.Column="9"
                      Margin="{StaticResource QualityNightInset}"
                      Content="{Binding Columns[9]}"
                      ContentTemplate="{StaticResource QualityHeaderCell}" />
    </Grid>

    <!-- 3. The rows, or the empty state. The scroller is bounded, so the virtualising panel inside
         it has something finite to measure against: this panel lives inside the export page's own
         body scroller, which would otherwise offer it infinite height and realise every row. -->
    <Border Grid.Row="2" Classes="rule" IsVisible="{Binding HasFrames}">
      <ScrollViewer x:Name="RowsScroller"
                    MaxHeight="420"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="VerdictRows" ItemsSource="{Binding Rows}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="wbpp:VerdictRowViewModel">
              <Grid x:Name="VerdictRow"
                    MinHeight="32"
                    ColumnDefinitions="56,88,72,68,68,68,68,68,*,112">
                <!-- Spec 12.13's Copy column: the per row override, which works in both
                     directions. -->
                <CheckBox Grid.Column="0"
                          x:Name="CopyCell"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="{Binding FileName}"
                          IsChecked="{Binding IsCopied, Mode=TwoWay}" />

                <TextBlock Grid.Column="1"
                           x:Name="VerdictCell"
                           Classes="qcell"
                           Classes.verdict-copy="{Binding IsVerdictCopy}"
                           Margin="4,0"
                           ToolTip.Tip="{Binding VerdictTooltip}"
                           Text="{Binding VerdictText}" />

                <TextBlock Grid.Column="2"
                           x:Name="FilterCell"
                           Classes="qcell"
                           Margin="4,0"
                           Text="{Binding FilterText}" />

                <!-- The five metric cells. Each is a value box of one fixed width and the mark
                     slot beside it, present whether or not the cell carries a mark. -->
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                  <TextBlock x:Name="HfrValue"
                             Classes="qcell num"
                             Classes.band-better="{Binding HfrCell.IsBetter}"
                             Classes.band-watch="{Binding HfrCell.IsWatch}"
                             Classes.band-reject="{Binding HfrCell.IsReject}"
                             Classes.failed="{Binding HfrCell.IsFailed}"
                             Width="{StaticResource QualityMetricValueWidth}"
                             ToolTip.Tip="{Binding HfrCell.Tooltip}"
                             Text="{Binding HfrCell.Text}" />
                  <TextBlock x:Name="HfrMark"
                             Classes="qcell failed"
                             Width="{StaticResource QualityMetricMarkWidth}"
                             TextAlignment="Center"
                             AutomationProperties.AccessibilityView="Raw"
                             Text="{Binding HfrCell.Mark}" />
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                  <TextBlock x:Name="EccValue"
                             Classes="qcell num"
                             Classes.band-better="{Binding EccentricityCell.IsBetter}"
                             Classes.band-watch="{Binding EccentricityCell.IsWatch}"
                             Classes.band-reject="{Binding EccentricityCell.IsReject}"
                             Classes.failed="{Binding EccentricityCell.IsFailed}"
                             Width="{StaticResource QualityMetricValueWidth}"
                             ToolTip.Tip="{Binding EccentricityCell.Tooltip}"
                             Text="{Binding EccentricityCell.Text}" />
                  <TextBlock x:Name="EccMark"
                             Classes="qcell failed"
                             Width="{StaticResource QualityMetricMarkWidth}"
                             TextAlignment="Center"
                             AutomationProperties.AccessibilityView="Raw"
                             Text="{Binding EccentricityCell.Mark}" />
                </StackPanel>
                <StackPanel Grid.Column="5" Orientation="Horizontal">
                  <TextBlock x:Name="FwhmValue"
                             Classes="qcell num"
                             Classes.band-better="{Binding FwhmCell.IsBetter}"
                             Classes.band-watch="{Binding FwhmCell.IsWatch}"
                             Classes.band-reject="{Binding FwhmCell.IsReject}"
                             Classes.failed="{Binding FwhmCell.IsFailed}"
                             Width="{StaticResource QualityMetricValueWidth}"
                             ToolTip.Tip="{Binding FwhmCell.Tooltip}"
                             Text="{Binding FwhmCell.Text}" />
                  <TextBlock x:Name="FwhmMark"
                             Classes="qcell failed"
                             Width="{StaticResource QualityMetricMarkWidth}"
                             TextAlignment="Center"
                             AutomationProperties.AccessibilityView="Raw"
                             Text="{Binding FwhmCell.Mark}" />
                </StackPanel>
                <StackPanel Grid.Column="6" Orientation="Horizontal">
                  <TextBlock x:Name="StarsValue"
                             Classes="qcell num"
                             Classes.band-better="{Binding DetectedStarsCell.IsBetter}"
                             Classes.band-watch="{Binding DetectedStarsCell.IsWatch}"
                             Classes.band-reject="{Binding DetectedStarsCell.IsReject}"
                             Classes.failed="{Binding DetectedStarsCell.IsFailed}"
                             Width="{StaticResource QualityMetricValueWidth}"
                             ToolTip.Tip="{Binding DetectedStarsCell.Tooltip}"
                             Text="{Binding DetectedStarsCell.Text}" />
                  <TextBlock x:Name="StarsMark"
                             Classes="qcell failed"
                             Width="{StaticResource QualityMetricMarkWidth}"
                             TextAlignment="Center"
                             AutomationProperties.AccessibilityView="Raw"
                             Text="{Binding DetectedStarsCell.Mark}" />
                </StackPanel>
                <!-- Spec 12.13: guiding RMS "has no baseline and is never coloured", so this cell
                     carries no band class at all. It keeps the failure ink and the mark slot,
                     because a guiding RMS gate can still fail. -->
                <StackPanel Grid.Column="7" Orientation="Horizontal">
                  <TextBlock x:Name="RmsValue"
                             Classes="qcell num"
                             Classes.failed="{Binding GuidingRmsCell.IsFailed}"
                             Width="{StaticResource QualityMetricValueWidth}"
                             ToolTip.Tip="{Binding GuidingRmsCell.Tooltip}"
                             Text="{Binding GuidingRmsCell.Text}" />
                  <TextBlock x:Name="RmsMark"
                             Classes="qcell failed"
                             Width="{StaticResource QualityMetricMarkWidth}"
                             TextAlignment="Center"
                             AutomationProperties.AccessibilityView="Raw"
                             Text="{Binding GuidingRmsCell.Mark}" />
                </StackPanel>

                <!-- Spec 12.13: the file name with the full path beneath it, "because one name can
                     live in several folders". -->
                <StackPanel Grid.Column="8" Margin="4,2" VerticalAlignment="Center">
                  <TextBlock x:Name="FileNameCell"
                             Classes="mono"
                             TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource ColorTextPrimary}"
                             Text="{Binding FileName}" />
                  <TextBlock x:Name="FilePathCell"
                             Classes="t-caption mono"
                             TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding FilePath}"
                             Text="{Binding FilePath}" />
                </StackPanel>

                <TextBlock Grid.Column="9"
                           x:Name="NightCell"
                           Classes="qcell num"
                           Margin="{StaticResource QualityNightInset}"
                           Foreground="{DynamicResource ColorTextTertiary}"
                           Text="{Binding NightText}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <TextBlock Grid.Row="2"
               x:Name="EmptyState"
               Classes="t-caption"
               Margin="0,8,0,0"
               IsVisible="{Binding !HasFrames}"
               Text="{Binding EmptyText}" />

    <!-- 4. Spec 12.13's sentence under the table, verbatim. -->
    <TextBlock Grid.Row="3"
               x:Name="FooterNote"
               Classes="t-caption"
               Margin="0,6,0,0"
               Text="{Binding FooterNote}" />
  </Grid>
</UserControl>
