<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:GalactiLog.App.Controls"
             xmlns:mos="using:GalactiLog.App.ViewModels.Mosaics"
             xmlns:mosaics="using:GalactiLog.App.Views.Mosaics"
             xmlns:dash="using:GalactiLog.App.ViewModels.Dashboard"
             xmlns:settings="using:GalactiLog.App.ViewModels.Settings"
             xmlns:sys="using:System"
             xmlns:t="using:GalactiLog.App.Controls.Table"
             x:Class="GalactiLog.App.Views.Mosaics.MosaicsView"
             x:Name="Root"
             x:DataType="mos:MosaicsPageViewModel">
  <!-- Spec 12.17's Mosaics page (Phase 18). Two columns, each with its own ScrollViewer, so the
       page itself never scrolls and a long suggestion list does not carry the mosaics table off
       screen. Flat sections with a heading row, not collapsible cards. Every colour is a theme
       token, nothing sets FontSize, and no button is filled: Run scan is the one filled button in
       the application (section 14).

       Both tables are on the table spine (spec.md items 1 to 9): t:TableRows over the column sets
       below, declared once, with their gutters, alignment, rules, zebra and faint dash from
       Theme/Table.axaml. MosaicsView.axaml.cs drops a column the gear hides. -->
  <UserControl.Resources>
    <!-- The mosaics table. The check column has no header cell: "Select all" sits above the
         table. Integration keeps the "12h 05m" form (ruling R15), whose units are its own. -->
    <t:TableColumns x:Key="MosaicCols" Id="Mosaic">
      <t:TableColumn Key="check" Kind="Check" />
      <t:TableColumn Key="name" Width="*" MinWidth="120" />
      <t:TableColumn Key="panels" Kind="Number" />
      <t:TableColumn Key="integration" Kind="Number" />
      <t:TableColumn Key="frames" Kind="Number" />
      <t:TableColumn Key="daterange" />
      <t:TableColumn Key="custom" Kind="Strip" />
      <t:TableColumn Key="actions" />
    </t:TableColumns>

    <!-- A suggestion's session table. One set for every expanded suggestion; each suggestion is
         its own size scope, so its columns fit its own sessions. -->
    <t:TableColumns x:Key="SuggestionSessionCols" Id="SuggSess">
      <t:TableColumn Key="check" Kind="Check" />
      <t:TableColumn Key="panel" />
      <t:TableColumn Key="object" Width="*" />
      <t:TableColumn Key="night" />
      <t:TableColumn Key="filter" />
      <t:TableColumn Key="frames" Kind="Number" />
      <t:TableColumn Key="integration" Kind="Number" />
    </t:TableColumns>

    <!-- An expanded mosaic's panel lines: no header, but one column set, so the figures line up
         from panel to panel. Each expanded mosaic is its own size scope. -->
    <t:TableColumns x:Key="PanelLineCols" Id="PanelLine">
      <t:TableColumn Key="label" />
      <t:TableColumn Key="targets" Width="*" />
      <t:TableColumn Key="integration" Kind="Number" />
      <t:TableColumn Key="frames" Kind="Number" />
      <t:TableColumn Key="actions" />
    </t:TableColumns>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- A session table row of an unchecked panel is drawn in the tertiary ink (spec 12.17). -->
    <Style Selector="t|TableRow.unchecked TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ColorTextTertiary}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*" Margin="16">
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
      <TextBlock Text="Mosaics" Classes="t-label section" VerticalAlignment="Center" />
      <controls:HelpButton Topic="mosaics.about" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,*">

      <!-- ===== Left column: detection keywords over suggestions ===== -->
      <ScrollViewer Grid.Column="0" Margin="0,0,8,0" VerticalScrollBarVisibility="Visible" t:Table.Scroller="True">
        <StackPanel Spacing="10">

          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="Detection keywords" Classes="section" VerticalAlignment="Center" />
              <controls:HelpButton Topic="mosaics.keywords" />
            </StackPanel>
            <Button Grid.Column="1"
                    x:Name="RunDetectionButton"
                    Classes="sm"
                    Content="Run Detection"
                    Command="{Binding RunDetectionCommand}"
                    ToolTip.Tip="{Binding RunDetectionTooltip}"
                    ToolTip.ShowOnDisabled="True" />
          </Grid>

          <ItemsControl x:Name="KeywordChips" ItemsSource="{Binding Keywords}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="sys:String">
                <Border Classes="tag" Margin="0,0,6,6">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                    <Button Classes="quiet"
                            Content="x"
                            Padding="2,0"
                            MinHeight="0"
                            ToolTip.Tip="Remove"
                            Command="{Binding #Root.((mos:MosaicsPageViewModel)DataContext).RemoveKeywordCommand}"
                            CommandParameter="{Binding}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Grid ColumnDefinitions="*,Auto">
            <TextBox x:Name="NewKeywordBox"
                     Watermark="New keyword"
                     Text="{Binding NewKeyword}">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding AddKeywordCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
            <Button Grid.Column="1" Classes="sm" Content="Add" Margin="8,0,0,0" Command="{Binding AddKeywordCommand}" />
          </Grid>
          <ContentControl Classes="callout error inline"
                          IsVisible="{Binding KeywordError, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding KeywordError}"
                       TextWrapping="Wrap" />
          </ContentControl>

          <StackPanel Spacing="4">
            <TextBlock Text="Position tolerance (arcmin)" Foreground="{DynamicResource ColorTextSecondary}" />
            <NumericUpDown x:Name="ToleranceBox"
                           Minimum="0"
                           Maximum="600"
                           Increment="1"
                           FormatString="0"
                           HorizontalAlignment="Left"
                           MinWidth="140"
                           Value="{Binding PositionTolerance}" />
            <TextBlock Text="0 derives it from the field of view." Classes="t-caption" Foreground="{DynamicResource ColorTextSecondary}" />
          </StackPanel>

          <TextBlock Text="Run Detection to apply."
                     IsVisible="{Binding ShowApplyCaption}"
                     Foreground="{DynamicResource ColorTextSecondary}" />

          <!-- Suggestions -->
          <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="{Binding SuggestionsHeading}" Classes="section" VerticalAlignment="Center" />
              <controls:HelpButton Topic="mosaics.suggestions" />
            </StackPanel>
            <ComboBox Grid.Column="1"
                      x:Name="CampaignGapBox"
                      ItemsSource="{Binding GapChoices}"
                      SelectedItem="{Binding SelectedGap}"
                      ToolTip.Tip="Campaign gap">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="mos:CampaignGapChoice">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>

          <TextBox x:Name="SuggestionFilterBox"
                   Watermark="Filter suggestions"
                   Text="{Binding FilterText}"
                   IsVisible="{Binding ShowFilter}" />

          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasVisibleSuggestions}">
            <CheckBox Content="Select all" IsChecked="{Binding AllSuggestionsSelected}" />
            <Button Classes="sm" Content="{Binding AcceptAllText}" Command="{Binding AcceptAllCommand}" />
            <Button Classes="sm" Content="{Binding DismissAllText}" Command="{Binding DismissAllCommand}" />
          </StackPanel>
          <ContentControl Classes="callout warn" IsVisible="{Binding DismissAllPending}">
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding DismissAllConfirmText}" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="sm" Content="Confirm" Command="{Binding DismissAllCommand}" />
                <Button Classes="sm" Content="Cancel" Command="{Binding CancelDismissAllCommand}" />
              </StackPanel>
            </StackPanel>
          </ContentControl>

          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding SuggestionsLoadFailed}">
            <ContentControl Classes="callout error inline" VerticalAlignment="Center">
              <TextBlock Text="{x:Static mos:MosaicsPageViewModel.SuggestionsLoadFailedText}" />
            </ContentControl>
            <Button Classes="quiet" Content="Retry" Foreground="{DynamicResource ColorAccent}" Command="{Binding RetrySuggestionsCommand}" />
          </StackPanel>
          <TextBlock x:Name="NoSuggestionsText"
                     Text="{x:Static mos:MosaicsPageViewModel.NoSuggestionsText}"
                     IsVisible="{Binding HasNoSuggestions}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource ColorTextTertiary}" />

          <ItemsControl x:Name="SuggestionList" ItemsSource="{Binding VisibleSuggestions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="mos:SuggestionRowViewModel">
                <Border Classes="rule" Padding="0,6">
                  <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                      <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Top" />
                      <Button Grid.Column="1" Classes="chevron" VerticalAlignment="Top" Command="{Binding ToggleExpandedCommand}">
                        <Panel>
                          <Path Width="16" Height="16" Classes="icon-glyph" Data="{StaticResource IconChevronRight}"
                                IsVisible="{Binding !IsExpanded}" />
                          <Path Width="16" Height="16" Classes="icon-glyph" Data="{StaticResource IconChevronRight}"
                                RenderTransform="rotate(90deg)" IsVisible="{Binding IsExpanded}" />
                        </Panel>
                      </Button>
                      <StackPanel Grid.Column="2" Spacing="2" Margin="4,0">
                        <WrapPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center" />
                          <Border Classes="tag" Margin="0,0,6,0" ToolTip.Tip="{Binding ConfidenceTooltip}">
                            <Panel>
                              <TextBlock Text="{Binding ConfidenceText}" IsVisible="{Binding IsHighConfidence}" Foreground="{DynamicResource ColorSuccess}" />
                              <TextBlock Text="{Binding ConfidenceText}" IsVisible="{Binding !IsHighConfidence}" />
                            </Panel>
                          </Border>
                          <Border Classes="tag">
                            <TextBlock Text="{Binding SourceText}" Foreground="{DynamicResource ColorTextSecondary}" />
                          </Border>
                        </WrapPanel>
                        <WrapPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding TotalsText}" Foreground="{DynamicResource ColorTextSecondary}" />
                          <Panel>
                            <TextBlock Text="{Binding FramesText}" IsVisible="{Binding !FramesAreZero}" Foreground="{DynamicResource ColorTextSecondary}" />
                            <TextBlock Text="{Binding FramesText}" IsVisible="{Binding FramesAreZero}" />
                          </Panel>
                          <TextBlock Text="{Binding IntegrationText}" Foreground="{DynamicResource ColorTextSecondary}" />
                          <TextBlock Text="{Binding MoreNightsText}" IsVisible="{Binding HasMoreNights}" Margin="8,0,0,0" />
                        </WrapPanel>
                      </StackPanel>
                      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                        <Button Classes="sm"
                                Content="{Binding AcceptText}"
                                Command="{Binding AcceptCommand}"
                                ToolTip.Tip="{Binding AcceptTooltip}"
                                ToolTip.ShowOnDisabled="True" />
                        <Button Classes="sm" Content="Dismiss" Command="{Binding DismissCommand}" />
                      </StackPanel>
                    </Grid>

                    <ContentControl Classes="callout warn" IsVisible="{Binding DismissPending}">
                      <StackPanel Spacing="6">
                        <TextBlock Text="{x:Static mos:SuggestionRowViewModel.DismissConfirmText}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button Classes="sm" Content="Confirm" Command="{Binding DismissCommand}" />
                          <Button Classes="sm" Content="Cancel" Command="{Binding CancelDismissCommand}" />
                        </StackPanel>
                      </StackPanel>
                    </ContentControl>
                    <ContentControl Classes="callout error inline"
                                    IsVisible="{Binding AcceptError, Converter={x:Static ObjectConverters.IsNotNull}}">
                      <TextBlock Text="{Binding AcceptError}"
                                 TextWrapping="Wrap" />
                    </ContentControl>

                    <StackPanel Spacing="8" IsVisible="{Binding IsExpanded}" Margin="28,0,0,0">
                      <ContentControl Classes="callout warn" IsVisible="{Binding HasFlags}">
                        <StackPanel Spacing="2">
                          <TextBlock Text="Review notes" FontWeight="SemiBold" />
                          <ItemsControl ItemsSource="{Binding Flags}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="sys:String">
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </ContentControl>

                      <ItemsControl ItemsSource="{Binding Targets}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="mos:SuggestionTargetLink">
                            <Button Classes="quiet"
                                    Content="{Binding Name}"
                                    Foreground="{DynamicResource ColorAccent}"
                                    Command="{Binding $parent[ItemsControl].((mos:SuggestionRowViewModel)DataContext).OpenTargetCommand}"
                                    CommandParameter="{Binding}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <!-- The session table. -->
                      <StackPanel Grid.IsSharedSizeScope="True">
                        <t:TableRow Kind="Header" Columns="{StaticResource SuggestionSessionCols}">
                          <CheckBox t:TableRow.Col="check" IsChecked="{Binding AllPanelsChecked}" />
                          <Button t:TableRow.Col="panel" Command="{Binding SortSessionsByCommand}" CommandParameter="panel">
                            <TextBlock Classes="t-label" Text="Panel" />
                          </Button>
                          <Button t:TableRow.Col="object" Command="{Binding SortSessionsByCommand}" CommandParameter="object" ToolTip.Tip="Object">
                            <TextBlock Classes="t-label" Text="Object" />
                          </Button>
                          <Button t:TableRow.Col="night" Command="{Binding SortSessionsByCommand}" CommandParameter="night">
                            <TextBlock Classes="t-label" Text="{x:Static t:TableHeads.Night}" />
                          </Button>
                          <Button t:TableRow.Col="filter" Command="{Binding SortSessionsByCommand}" CommandParameter="filter">
                            <TextBlock Classes="t-label" Text="{x:Static t:TableHeads.Filter}" />
                          </Button>
                          <Button t:TableRow.Col="frames" Command="{Binding SortSessionsByCommand}" CommandParameter="frames">
                            <TextBlock Classes="t-label" Text="{x:Static t:TableHeads.Frames}" />
                          </Button>
                          <Button t:TableRow.Col="integration" Command="{Binding SortSessionsByCommand}" CommandParameter="integration">
                            <TextBlock Classes="t-label" Text="Integration" />
                          </Button>
                        </t:TableRow>
                        <ItemsControl Classes="table" ItemsSource="{Binding Sessions}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="mos:SuggestionSessionViewModel">
                              <t:TableRow Columns="{StaticResource SuggestionSessionCols}" Classes.unchecked="{Binding !IsChecked}">
                                <CheckBox t:TableRow.Col="check" IsChecked="{Binding IsChecked}" />
                                <TextBlock t:TableRow.Col="panel" Text="{Binding Data.Label}" />
                                <TextBlock t:TableRow.Col="object" Text="{Binding Data.ObjectName}" ToolTip.Tip="{Binding Data.ObjectName}" />
                                <TextBlock t:TableRow.Col="night" Text="{Binding NightText}" />
                                <TextBlock t:TableRow.Col="filter" Text="{Binding FilterText}" />
                                <TextBlock t:TableRow.Col="frames" Text="{Binding FramesText}" />
                                <TextBlock t:TableRow.Col="integration" Text="{Binding IntegrationText}" />
                              </t:TableRow>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>

                      <!-- Spec 12.17's read-only tile preview (Phase 19A, ruling R18): the arranger
                           with no toolbar and no hit test, so a wheel over it reaches the column's
                           ScrollViewer, one tile per checked label. -->
                      <TextBlock Classes="t-caption" Text="Tile preview" />
                      <Border Height="200" IsVisible="{Binding !Preview.IsEmpty}">
                        <mosaics:ArrangerView DataContext="{Binding Preview}" IsHitTestVisible="False" />
                      </Border>
                      <TextBlock Text="{x:Static mos:ArrangerViewModel.NoPanelsText}"
                                 IsVisible="{Binding Preview.IsEmpty}"
                                 Foreground="{DynamicResource ColorTextTertiary}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <!-- ===== Right column: the mosaics table ===== -->
      <ScrollViewer Grid.Column="1" Margin="8,0,0,0" VerticalScrollBarVisibility="Visible" t:Table.Scroller="True"
                    DataContext="{Binding Table}" x:DataType="mos:MosaicsTableViewModel">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="{Binding MosaicsHeading}" Classes="section" VerticalAlignment="Center" />
              <controls:HelpButton Topic="mosaics.table" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Button Classes="sm"
                      Content="{Binding DeleteSelectedText}"
                      IsVisible="{Binding HasSelectedMosaics}"
                      Command="{Binding DeleteSelectedCommand}" />
              <Button x:Name="CreateMosaicButton" Classes="sm" Content="{Binding CreateButtonText}" Command="{Binding ToggleCreateCommand}" />
              <Button x:Name="MosaicColumnGear" Padding="8,3" ToolTip.Tip="Columns">
                <Path Width="16" Height="16" Classes="icon-glyph" Data="{StaticResource IconGear}" />
                <Button.Flyout>
                  <Flyout>
                    <ItemsControl ItemsSource="{Binding Picker.Groups}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="settings:ColumnGroupViewModel">
                          <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Heading}"
                                       Margin="0,4,0,0"
                                       IsVisible="{Binding #Root.((mos:MosaicsPageViewModel)DataContext).Table.Picker.ShowGroupHeadings}"
                                       Foreground="{DynamicResource ColorTextTertiary}" />
                            <ItemsControl ItemsSource="{Binding Columns}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="dash:ColumnViewModel">
                                  <CheckBox Content="{Binding Title}"
                                            IsChecked="{Binding IsVisible, Mode=OneWay}"
                                            IsEnabled="{Binding CanHide}"
                                            Command="{Binding #Root.((mos:MosaicsPageViewModel)DataContext).Table.Picker.ToggleCommand}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Flyout>
                </Button.Flyout>
              </Button>
            </StackPanel>
          </Grid>

          <ContentControl Classes="callout warn" IsVisible="{Binding DeleteSelectedPending}">
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding DeleteSelectedConfirmText}" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="sm" Content="Confirm" Command="{Binding DeleteSelectedCommand}" />
                <Button Classes="sm" Content="Cancel" Command="{Binding CancelDeleteSelectedCommand}" />
              </StackPanel>
            </StackPanel>
          </ContentControl>

          <StackPanel Spacing="4" IsVisible="{Binding IsCreateOpen}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBox x:Name="NewMosaicNameBox" Watermark="Mosaic name" Text="{Binding NewMosaicName}">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding CreateCommand}" />
                </TextBox.KeyBindings>
              </TextBox>
              <Button Grid.Column="1" Classes="sm" Content="Create" Margin="8,0,0,0" Command="{Binding CreateCommand}" />
            </Grid>
            <ContentControl Classes="callout error inline"
                            IsVisible="{Binding CreateError, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Text="{Binding CreateError}"
                         TextWrapping="Wrap" />
            </ContentControl>
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding LoadFailed}">
            <ContentControl Classes="callout error inline" VerticalAlignment="Center">
              <TextBlock Text="{x:Static mos:MosaicsTableViewModel.LoadFailedText}" />
            </ContentControl>
            <Button Classes="quiet" Content="Retry" Foreground="{DynamicResource ColorAccent}" Command="{Binding RetryCommand}" />
          </StackPanel>
          <TextBlock x:Name="NoMosaicsText"
                     Text="{x:Static mos:MosaicsTableViewModel.NoMosaicsText}"
                     IsVisible="{Binding HasNoMosaics}"
                     Foreground="{DynamicResource ColorTextTertiary}" />

          <CheckBox Content="Select all" IsChecked="{Binding AllMosaicsSelected}" IsVisible="{Binding ShowSelectAllMosaics}" />

          <StackPanel Grid.IsSharedSizeScope="True" IsVisible="{Binding ShowRows}">
            <!-- The header row. Each built-in header sorts; a custom column's header does not. -->
            <t:TableRow Kind="Header" Columns="{StaticResource MosaicCols}">
              <Button t:TableRow.Col="name"
                      ToolTip.Tip="{Binding Picker.Columns[0].Title}"
                      Command="{Binding SortByCommand}"
                      CommandParameter="name"
                      Content="{Binding Picker.Columns[0]}"
                      ContentTemplate="{StaticResource TableSortTitle}" />
              <Button t:TableRow.Col="panels"
                      Command="{Binding SortByCommand}"
                      CommandParameter="panels"
                      Content="{Binding Picker.Columns[1]}"
                      ContentTemplate="{StaticResource TableSortTitleNumeric}" />
              <Button t:TableRow.Col="integration"
                      Command="{Binding SortByCommand}"
                      CommandParameter="integration"
                      Content="{Binding Picker.Columns[2]}"
                      ContentTemplate="{StaticResource TableSortTitleNumeric}" />
              <Button t:TableRow.Col="frames"
                      Command="{Binding SortByCommand}"
                      CommandParameter="frames"
                      Content="{Binding Picker.Columns[3]}"
                      ContentTemplate="{StaticResource TableSortTitleNumeric}" />
              <Button t:TableRow.Col="daterange"
                      Command="{Binding SortByCommand}"
                      CommandParameter="date_range"
                      Content="{Binding Picker.Columns[4]}"
                      ContentTemplate="{StaticResource TableSortTitle}" />
              <ItemsControl t:TableRow.Col="custom"
                            ItemsSource="{Binding ShownCustomColumns}"
                            ItemTemplate="{StaticResource TableCustomHead}" />
            </t:TableRow>

            <ItemsControl x:Name="MosaicList" Classes="table" ItemsSource="{Binding Mosaics}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="mos:MosaicRowViewModel">
                  <StackPanel>
                    <Panel>
                      <!-- The row's own click target sits behind the cells, the dashboard's shape:
                           a click outside the row's controls opens the mosaic detail page. -->
                      <Button Command="{Binding OpenCommand}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="Transparent"
                              BorderThickness="0"
                              IsTabStop="False"
                              AutomationProperties.Name="{Binding Name}"
                              MinHeight="0"
                              Padding="0" />
                      <t:TableRow Columns="{StaticResource MosaicCols}">
                        <CheckBox t:TableRow.Col="check" IsChecked="{Binding IsSelected}" />
                        <TextBlock t:TableRow.Col="name" Text="{Binding Name}" ToolTip.Tip="{Binding Name}"
                                   Foreground="{DynamicResource ColorTextPrimary}" />
                        <TextBlock t:TableRow.Col="panels" Text="{Binding PanelsText}" />
                        <TextBlock t:TableRow.Col="integration" Text="{Binding IntegrationText}" />
                        <TextBlock t:TableRow.Col="frames" Text="{Binding FramesText}" />
                        <TextBlock t:TableRow.Col="daterange" Text="{Binding DateRangeText}" />
                        <ItemsControl t:TableRow.Col="custom"
                                      ItemsSource="{Binding CustomCells}"
                                      ItemTemplate="{StaticResource TableCustomCell}" />
                        <StackPanel t:TableRow.Col="actions" Orientation="Horizontal" Spacing="6">
                          <Button Classes="sm" Content="Delete" Command="{Binding DeleteCommand}" />
                          <Button Classes="sm" Content="{Binding ExpandText}" Command="{Binding ToggleExpandCommand}" />
                        </StackPanel>
                      </t:TableRow>
                    </Panel>

                    <ContentControl Classes="callout warn" IsVisible="{Binding DeletePending}" Margin="0,4">
                      <StackPanel Spacing="6">
                        <TextBlock Text="{x:Static mos:MosaicRowViewModel.DeleteConfirmText}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button Classes="sm" Content="Confirm" Command="{Binding DeleteCommand}" />
                          <Button Classes="sm" Content="Cancel" Command="{Binding CancelDeleteCommand}" />
                        </StackPanel>
                      </StackPanel>
                    </ContentControl>
                    <ContentControl Classes="callout error inline"
                                    IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}">
                      <TextBlock Text="{Binding Error}"
                                 TextWrapping="Wrap" />
                    </ContentControl>

                    <!-- The expanded row: Rename, the panel list, the add panel form. -->
                    <StackPanel Spacing="8" Margin="28,6,0,10" IsVisible="{Binding IsExpanded}">
                      <Button Classes="sm" Content="Rename" HorizontalAlignment="Left"
                              IsVisible="{Binding !IsRenaming}" Command="{Binding BeginRenameCommand}" />
                      <StackPanel Spacing="4" IsVisible="{Binding IsRenaming}">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                          <TextBox Text="{Binding RenameText}">
                            <TextBox.KeyBindings>
                              <KeyBinding Gesture="Enter" Command="{Binding SaveRenameCommand}" />
                              <KeyBinding Gesture="Escape" Command="{Binding CancelRenameCommand}" />
                            </TextBox.KeyBindings>
                          </TextBox>
                          <Button Grid.Column="1" Classes="sm" Content="Save" Margin="8,0,0,0" Command="{Binding SaveRenameCommand}" />
                          <Button Grid.Column="2" Classes="sm" Content="Cancel" Margin="8,0,0,0" Command="{Binding CancelRenameCommand}" />
                        </Grid>
                        <ContentControl Classes="callout error inline"
                                        IsVisible="{Binding RenameError, Converter={x:Static ObjectConverters.IsNotNull}}">
                          <TextBlock Text="{Binding RenameError}" />
                        </ContentControl>
                      </StackPanel>

                      <TextBlock Text="{x:Static mos:MosaicRowViewModel.NoPanelsText}"
                                 IsVisible="{Binding HasNoPanels}"
                                 Foreground="{DynamicResource ColorTextTertiary}" />
                      <ItemsControl ItemsSource="{Binding PanelLines}" Grid.IsSharedSizeScope="True">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="mos:PanelLineViewModel">
                            <StackPanel Spacing="4">
                              <t:TableRow Columns="{StaticResource PanelLineCols}">
                                <TextBlock t:TableRow.Col="label" Text="{Binding Label}" FontWeight="SemiBold" />
                                <TextBlock t:TableRow.Col="targets"
                                           Text="{Binding TargetsText}"
                                           ToolTip.Tip="{Binding TargetsText}"
                                           Foreground="{DynamicResource ColorTextSecondary}" />
                                <TextBlock t:TableRow.Col="integration" Text="{Binding IntegrationText}" />
                                <TextBlock t:TableRow.Col="frames" Text="{Binding FramesText}" />
                                <Button t:TableRow.Col="actions" Classes="sm" Content="Remove" Command="{Binding RemoveCommand}" />
                              </t:TableRow>
                              <ContentControl Classes="callout warn" IsVisible="{Binding RemovePending}">
                                <StackPanel Spacing="6">
                                  <TextBlock Text="{Binding RemoveConfirmText}" TextWrapping="Wrap" />
                                  <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="sm" Content="Confirm" Command="{Binding RemoveCommand}" />
                                    <Button Classes="sm" Content="Cancel" Command="{Binding CancelRemoveCommand}" />
                                  </StackPanel>
                                </StackPanel>
                              </ContentControl>
                              <ContentControl Classes="callout error inline"
                                              IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <TextBlock Text="{Binding Error}" />
                              </ContentControl>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <!-- The add panel form (AddPanelViewModel), shared with the detail page. -->
                      <StackPanel Spacing="4" DataContext="{Binding AddPanel}" x:DataType="mos:AddPanelViewModel">
                        <TextBlock Text="Add panel" FontWeight="SemiBold" />
                        <TextBox Watermark="Search targets" Text="{Binding SearchText}" />
                        <ItemsControl ItemsSource="{Binding SearchResults}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="dash:SearchResultViewModel">
                              <Button Classes="quiet"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Left"
                                      Content="{Binding DisplayName}"
                                      Command="{Binding $parent[ItemsControl].((mos:AddPanelViewModel)DataContext).ChooseCommand}"
                                      CommandParameter="{Binding}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Chosen.DisplayName, StringFormat='Target: {0}'}"
                                   IsVisible="{Binding Chosen, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBox Watermark="Panel label" Text="{Binding Label}" />
                          <Button Grid.Column="1" Classes="sm" Content="Add" Margin="8,0,0,0" Command="{Binding AddCommand}" />
                        </Grid>
                        <TextBlock Text="{Binding Caption}"
                                   IsVisible="{Binding Caption, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   Foreground="{DynamicResource ColorTextSecondary}" />
                        <ContentControl Classes="callout error inline"
                                        IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}">
                          <TextBlock Text="{Binding Error}"
                                     TextWrapping="Wrap" />
                        </ContentControl>
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
