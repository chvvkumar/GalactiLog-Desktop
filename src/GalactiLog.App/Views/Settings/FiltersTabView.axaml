<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:GalactiLog.App.Controls"
             xmlns:settings="using:GalactiLog.App.ViewModels.Settings"
             xmlns:settingsviews="using:GalactiLog.App.Views.Settings"
             x:Class="GalactiLog.App.Views.Settings.FiltersTabView"
             x:Name="Root"
             x:DataType="settings:FiltersTabViewModel">
  <!-- Design-spec 12.7's Filters tab: suggestions banner, the canonical filter table (a
       GroupingEditorView with ShowColorPicker true), an add-filter row, and Save. Every colour is
       a theme token and nothing here sets FontSize. -->
  <!-- The suggestion pill is Theme/Controls.axaml's Button.pill, which P12 Task 5 lifted out of
       this file, EquipmentTabView.axaml and ActivityView.axaml. The rule the local copy existed
       for still holds and now holds in one place: the base background is a style setter and never
       an inline attribute on the Button, because an inline value is a LocalValue and always
       outranks a style setter, which is exactly what made the selected pill never highlight
       before that fix. -->
  <ScrollViewer>
    <StackPanel Spacing="16">
      <TextBlock x:Name="LoadFailedText"
                 Text="{Binding LoadFailedMessage}"
                 IsVisible="{Binding LoadFailed}"
                 Foreground="{DynamicResource ColorTextTertiary}" />

      <!-- Spec 12.10: while the first load is in flight, say so rather than showing an empty
           editor with no indication anything is happening (review minor 8). -->
      <TextBlock x:Name="LoadingText"
                 Text="Loading..."
                 IsVisible="{Binding IsLoading}"
                 Foreground="{DynamicResource ColorTextTertiary}" />

      <!-- Suggestions banner: the web's SuggestionsBanner.tsx, shown only while there is at
           least one suggestion. -->
      <ContentControl x:Name="SuggestionsBanner"
              Classes="callout warn"
              IsVisible="{Binding HasSuggestions}"
              Padding="16">
        <StackPanel Spacing="10">
          <TextBlock x:Name="SuggestionsHeadingText"
                     Text="{Binding SuggestionsHeading}" />
          <ItemsControl x:Name="SuggestionList" ItemsSource="{Binding Suggestions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="settings:SuggestionViewModel">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                  <ItemsControl ItemsSource="{Binding Pills}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="4" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="settings:SuggestionPillViewModel">
                        <Button Classes="pill"
                                Classes.selected="{Binding IsSelected}"
                                Content="{Binding Label}"
                                Command="{Binding $parent[ItemsControl].((settings:SuggestionViewModel)DataContext).SelectCommand}"
                                CommandParameter="{Binding Name}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button x:Name="AcceptButton"
                          Content="Merge"
                          Padding="8,3"
                          Command="{Binding #Root.((settings:FiltersTabViewModel)DataContext).AcceptSuggestionCommand}"
                          CommandParameter="{Binding}" />
                  <Button x:Name="DismissButton"
                          Content="Dismiss"
                          Padding="8,3"
                          Command="{Binding #Root.((settings:FiltersTabViewModel)DataContext).DismissSuggestionCommand}"
                          CommandParameter="{Binding}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ContentControl>

      <!-- Spec 12.7's "table of canonical filters, each with a colour swatch and an alias list
           editor", built from the same GroupingEditorViewModel the web's GroupingEditor
           component drives with showColorPicker true. -->
      <Border x:Name="FilterGroupsCard"
              Background="{DynamicResource ColorBgSurface}"
              BorderBrush="{DynamicResource ColorBorderDefault}"
              BorderThickness="1"
              CornerRadius="{StaticResource RadiusMd}"
              Padding="16">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Filter Groups"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource ColorTextPrimary}" />
            <controls:HelpButton Topic="settings.filters.groups" />
          </StackPanel>
          <ContentControl x:Name="EditorRegion" Content="{Binding Editor}" />

          <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0"
                     x:Name="NewFilterNameBox"
                     Watermark="New filter name"
                     Background="{DynamicResource ColorBgInput}"
                     Foreground="{DynamicResource ColorTextPrimary}"
                     Text="{Binding NewFilterName, Mode=TwoWay}">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding AddFilterCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
            <Button Grid.Column="1"
                    x:Name="AddFilterButton"
                    Content="Add Filter"
                    Margin="6,0,0,0"
                    Padding="10,3"
                    Command="{Binding AddFilterCommand}" />
          </Grid>
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button x:Name="SaveButton"
                Content="Save"
                Padding="10,3"
                Command="{Binding SaveCommand}" />
        <ContentControl Classes="callout error inline"
                        IsVisible="{Binding HasErrorMessage}">
          <TextBlock x:Name="FilterErrorText"
                     Text="{Binding ErrorMessage}"
                     TextWrapping="Wrap" />
        </ContentControl>
        <TextBlock x:Name="FilterStatusText"
                   Text="{Binding StatusMessage}"
                   IsVisible="{Binding HasStatusMessage}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource ColorSuccess}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
