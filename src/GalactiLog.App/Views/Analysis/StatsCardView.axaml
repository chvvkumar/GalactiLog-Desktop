<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:analysis="using:GalactiLog.App.ViewModels.Analysis"
             x:Class="GalactiLog.App.Views.Analysis.StatsCardView"
             x:DataType="analysis:StatsCardViewModel"
             IsVisible="{Binding IsVisible}">
  <!-- Spec 12.14's one stats card, used by the Correlation tab and by Compare. Six
       fields in the order the web draws them: N, Min, Max, Mean, Median, StDev. Absent stats hide
       the card rather than showing zeroes, which is the view-model's own IsVisible and is bound on
       the root here so no host has to remember it.

       Ledger vocabulary: no Border.card and no CornerRadius, containment is alignment and the
       shared Border.rule hairline, and every figure takes the shared num class for its tabular
       figures and right alignment. -->
  <StackPanel Spacing="2">
    <TextBlock Text="{Binding Label}"
               Classes="t-label"
               IsVisible="{Binding HasLabel}"
               TextTrimming="CharacterEllipsis" />
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12">
      <TextBlock Grid.Row="0" Grid.Column="0" Text="N" Classes="t-caption" />
      <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Count}" Classes="num" />
      <TextBlock Grid.Row="1" Grid.Column="0" Text="Min" Classes="t-caption" />
      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Min}" Classes="num" />
      <TextBlock Grid.Row="2" Grid.Column="0" Text="Max" Classes="t-caption" />
      <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Max}" Classes="num" />
      <TextBlock Grid.Row="3" Grid.Column="0" Text="Mean" Classes="t-caption" />
      <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Mean}" Classes="num" />
      <TextBlock Grid.Row="4" Grid.Column="0" Text="Median" Classes="t-caption" />
      <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Median}" Classes="num" />
      <TextBlock Grid.Row="5" Grid.Column="0" Text="StDev" Classes="t-caption" />
      <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding StdDev}" Classes="num" />
    </Grid>
  </StackPanel>
</UserControl>
