<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avc="using:Avalonia.Data.Converters"
             xmlns:dash="using:GalactiLog.App.ViewModels.Dashboard"
             xmlns:settings="using:GalactiLog.App.ViewModels.Settings"
             xmlns:t="using:GalactiLog.App.Controls.Table"
             xmlns:vmtd="using:GalactiLog.App.ViewModels.TargetDetail"
             x:Class="GalactiLog.App.Views.Dashboard.TargetListView"
             x:Name="Root"
             x:DataType="dash:TargetListViewModel">
  <!-- design-spec 12.2's target list. An ItemsControl and a header row rather than a DataGrid:
       Avalonia's DataGrid is a separate package that Directory.Packages.props does not pin, and
       dynamic column visibility plus a per-row expander plus tinted badge cells are more work to
       bend a DataGrid into than to lay out directly (coordinator ruling Q7).

       The table spine (spec.md items 1 to 9): the header row, every target row and the night
       expander's rows are t:TableRows over the two column sets below, declared once. Each set's
       Auto columns are shared size groups, so each is as wide as its widest cell across the header
       and every realized row; gutters, alignment, trimming, the header rule, the zebra and the
       faint dash all come from Theme/Table.axaml, never from a cell.

       The row fits its viewport at every width down to about 680 and is never carried by a
       horizontal scroller (fix pass, review C1); see the ScrollViewer's own comment below for why
       the scroller has to be disabled rather than merely hidden.

       Cells follow ColumnViewModel.IsShown through TableColumn.IsDropped, which
       TargetListView.axaml.cs writes, so the dashboard and the frame table render through one
       property and a hidden column leaves its shared size group as well as its cells.

       Nothing here sets FontSize. Scales.axaml's FontSize* keys are ratios (0.5 to 0.714), not
       point sizes, so binding one to FontSize renders sub-pixel text (review item 1). Every colour
       is a theme token (spec 14) except a palette badge's tint, which is the configured filter
       colour and therefore user data. -->
  <UserControl.Resources>
    <!-- The target table. Name is the one star column: a shared size group cannot be star sized,
         and it still aligns because every row is drawn at the same width. Its floor holds a
         catalogue designation; its cap, and Designation's and Equipment's, are written from
         TargetListView.axaml.cs, which owns the fit arithmetic. The sessions column is Number kind
         for its trailing alignment: the gear over it and the Expand buttons under it all end one
         gutter inside the row. -->
    <t:TableColumns x:Key="TargetCols" Id="Target">
      <t:TableColumn Key="name" Width="*" MinWidth="120" />
      <t:TableColumn Key="designation" />
      <t:TableColumn Key="palette" />
      <t:TableColumn Key="integration" Kind="Number" />
      <t:TableColumn Key="equipment" />
      <t:TableColumn Key="lastsession" />
      <t:TableColumn Key="custom" Kind="Strip" />
      <t:TableColumn Key="sessions" Kind="Number" />
    </t:TableColumns>

    <!-- The night expander's table (spec 12.2's session columns, plus spec 12.15 amendment 2.4's
         session-scope cells and the Deep dive action). One set for every expanded row on the page,
         so the nights of two open targets line up too. -->
    <t:TableColumns x:Key="SessCols" Id="Sess">
      <t:TableColumn Key="date" />
      <t:TableColumn Key="frames" Kind="Number" />
      <t:TableColumn Key="hours" Kind="Number" />
      <t:TableColumn Key="filters" />
      <t:TableColumn Key="custom" Kind="Strip" />
      <t:TableColumn Key="action" />
    </t:TableColumns>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,*" Grid.IsSharedSizeScope="True">
    <!-- The toolbar bar (spec 12.2 Pager paragraph, Phase 14C Task 4): one card above the table,
         the web's own arrangement. The count and the page size read together on the left, the
         count first because it is read before the rows (questions.md Q5, which is why
         PageStatusText stays and stays rendered here); the pager sits on the right.

         The left group is a DockPanel left-aligned in the star column: the page-size select docks
         after the count and the count fills, so the group is as wide as its content and, when the
         bar is short, the count is the one element that trims, since the lit page button already
         carries the current page. Spec 12.2's own pageRange rule caps the page buttons at seven
         slots whatever the total, so the pager's Auto column is inherently bounded. -->
    <Border Grid.Row="0"
            x:Name="TargetListToolbar"
            Classes="card"
            Padding="12,8"
            Margin="0,0,0,8">
      <Grid x:Name="TargetListPager" ColumnDefinitions="*,Auto">
        <DockPanel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center">
          <!-- Spec 5.8.1's four choices, writing general.default_page_size on selection through
               TargetListViewModel.SelectedPageSize. An unlisted stored value reads as the select's
               own default, 50 (NormalizePageSize), rather than clamping to the nearest option. -->
          <StackPanel DockPanel.Dock="Right"
                      Orientation="Horizontal"
                      Spacing="8"
                      Margin="16,0,0,0"
                      VerticalAlignment="Center">
            <TextBlock Text="Rows per page"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource ColorTextSecondary}" />
            <ComboBox ItemsSource="{x:Static dash:TargetListViewModel.PageSizeOptions}"
                      SelectedItem="{Binding SelectedPageSize}" />
          </StackPanel>
          <!-- The page's own title, the left-most element of the bar rather than a row of its own
               above it, so the table keeps every pixel of height it had. -->
          <TextBlock x:Name="PageTitle"
                     DockPanel.Dock="Left"
                     Classes="t-title"
                     Text="Dashboard"
                     Margin="0,0,16,0"
                     VerticalAlignment="Center" />
          <!-- Fix pass (task4-review.md P2): the range alone ("1 to 25 of 120"), the web's own
               line, rather than repeating the page count the buttons already show. -->
          <TextBlock Text="{Binding PageStatusText}"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource ColorTextSecondary}" />
        </DockPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="4"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center">
          <Button Classes="sm" Content="Previous" Command="{Binding PreviousPageCommand}" />

          <!-- The web's own pageRange rule (TargetFeed.tsx), transcribed in
               TargetListViewModel.BuildPageButtons: one button per page number, and the ellipsis a
               non-interactive text run of three ASCII full stops rather than a Button (task4.md
               section 6). Neither carries a TargetRowViewModel as its CommandParameter, so a page
               click can never be mistaken for a row click. -->
          <ItemsControl ItemsSource="{Binding PageButtons}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="dash:PageButtonViewModel">
                <Panel>
                  <TextBlock Text="..."
                             IsVisible="{Binding Page, Converter={x:Static ObjectConverters.IsNull}}"
                             Padding="4,0"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource ColorTextTertiary}" />
                  <!-- Button.page.current (Theme/Controls.axaml, Phase 14C Task 4) marks the
                       current page; Button.sm keeps every page button the pager's own row height.
                       GoToPageCommand carries no CanExecute (TRACKING item 13: the gate is the
                       body's, past a click that reaches it directly), so the numbered buttons grey
                       through a direct IsEnabled binding instead (fix pass, task4-review.md P3). -->
                  <Button Classes="sm page"
                          Classes.current="{Binding IsCurrent}"
                          IsVisible="{Binding Page, Converter={x:Static ObjectConverters.IsNotNull}}"
                          IsEnabled="{Binding #Root.((dash:TargetListViewModel)DataContext).IsRefetching, Converter={x:Static avc:BoolConverters.Not}}"
                          Content="{Binding Page}"
                          Command="{Binding #Root.((dash:TargetListViewModel)DataContext).GoToPageCommand}"
                          CommandParameter="{Binding Page}" />
                </Panel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Button Classes="sm" Content="Next" Command="{Binding NextPageCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- The table card. No padding, so the header rule and the zebra bands run edge to edge inside
         its hairline; the cells' own gutters are the inset. -->
    <Border Grid.Row="1"
            x:Name="TargetListCard"
            Classes="card"
            Padding="0">
    <Grid RowDefinitions="Auto,*">
    <!-- Header row, one cell per column in the order DisplaySettings.DefaultColumns["dashboard"]
         declares, then the custom strip and the sessions column. The sessions column is not a
         persistable column key (spec 5.8.2's default list holds six): its header cell holds the
         column gear rather than a sort button.

         The header sits outside the scroller, whose vertical bar is always drawn and reserves its
         width, so the header is inset by the same ScrollInset and is drawn at a row's own width:
         Name is a star column mid-row, and a header measured narrower than a row would put every
         column after it out of line with its cells.

         Name carries NameCellMaxWidth on the header cell and on every row cell: a star column in
         Avalonia does not shrink below its cell's desired width, so bounding both by one computed
         figure is what stops the header and the rows resolving different column sets. -->
    <t:TableRow Grid.Row="0"
                x:Name="TargetListHeaderRow"
                Kind="Header"
                Columns="{StaticResource TargetCols}"
                Margin="{x:Static t:TableMetrics.ScrollInset}">
      <!-- One sort button per column, over the shared title templates. A column with no sort
           mapping (designation, palette) still renders as a button; the command ignores it, which
           is one branch in the view-model instead of two header kinds. -->
      <Button t:TableRow.Col="name"
              MaxWidth="{Binding #Root.NameCellMaxWidth}"
              ToolTip.Tip="{Binding Columns[0].Title}"
              Command="{Binding SortByCommand}"
              CommandParameter="{Binding Columns[0].Key}"
              Content="{Binding Columns[0]}"
              ContentTemplate="{StaticResource TableSortTitle}" />
      <Button t:TableRow.Col="designation"
              ToolTip.Tip="{Binding Columns[1].Title}"
              Command="{Binding SortByCommand}"
              CommandParameter="{Binding Columns[1].Key}"
              Content="{Binding Columns[1]}"
              ContentTemplate="{StaticResource TableSortTitle}" />
      <Button t:TableRow.Col="palette"
              Command="{Binding SortByCommand}"
              CommandParameter="{Binding Columns[2].Key}"
              Content="{Binding Columns[2]}"
              ContentTemplate="{StaticResource TableSortTitle}" />
      <Button t:TableRow.Col="integration"
              Command="{Binding SortByCommand}"
              CommandParameter="{Binding Columns[3].Key}"
              Content="{Binding Columns[3]}"
              ContentTemplate="{StaticResource TableSortTitleNumeric}" />
      <Button t:TableRow.Col="equipment"
              ToolTip.Tip="{Binding Columns[4].Title}"
              Command="{Binding SortByCommand}"
              CommandParameter="{Binding Columns[4].Key}"
              Content="{Binding Columns[4]}"
              ContentTemplate="{StaticResource TableSortTitle}" />
      <Button t:TableRow.Col="lastsession"
              Command="{Binding SortByCommand}"
              CommandParameter="{Binding Columns[5].Key}"
              Content="{Binding Columns[5]}"
              ContentTemplate="{StaticResource TableSortTitle}" />

      <!-- Spec 12.15's custom column labels, one per drawn column, at the widths the row cells
           carry (both measured by CustomCellWidths.HeadingWidth). No sort button and no picker of
           its own: the column gear beside it is what switches a custom column on and off. -->
      <ItemsControl t:TableRow.Col="custom"
                    x:Name="CustomHeaderStrip"
                    ItemsSource="{Binding DrawnCustomColumns}"
                    ItemTemplate="{StaticResource TableCustomHead}" />

      <!-- The sessions column's header cell: the column gear, with no sort button. -->
      <StackPanel t:TableRow.Col="sessions"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center">
        <!-- Column picker: a gear rather than a text label (spec 12.2, ruling D4). DESIGN.md
             section 8 and spec 14.5 refuse a Unicode glyph standing in for an icon (questions.md
             Q10), so this draws a Path over Theme/Controls.axaml's IconGear StreamGeometry, the
             same idiom IconHelpRing/IconHelpMark already use, rather than typing a character. The
             tooltip keeps the word the button used to show as its label. Each checkbox in the
             flyout still raises ToggleColumn rather than writing IsVisible itself, so the
             persisted list and the checkboxes cannot disagree; name's is disabled (ruling Q5).
             This flyout, the live Columns list and ToggleColumnCommand it binds are already the
             same instance AppHost.cs hands the Display tab's picker (ruling D4's "one
             ColumnPickerViewModel instance shown in two places"). -->
        <Button x:Name="ColumnGearButton"
                Padding="8,3"
                ToolTip.Tip="Columns">
          <!-- Phase 14B fixer, fixer list item 41: Path.icon-glyph from Theme/Controls.axaml,
               which is the one declaration of these four stroke setters and carries the
               pointer-over ink this icon had none of. The 16 square here is the icon's own size,
               not a cell width: View_NoCellDeclaresAFixedWidth allows an icon's Path by name,
               this one and the Nights chevron. -->
          <Path Width="16"
                Height="16"
                Classes="icon-glyph"
                Data="{StaticResource IconGear}" />
          <!-- Spec 12.15: custom columns are listed under a "Custom" heading below the built-in
               ones, so the flyout draws the picker's own groups rather than the flat column list.
               ShowGroupHeadings is false while only one group exists, which is every library with
               no target-scope custom column. -->
          <Button.Flyout>
            <Flyout>
              <ItemsControl ItemsSource="{Binding ColumnPicker.Groups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="settings:ColumnGroupViewModel">
                    <StackPanel Spacing="2">
                      <TextBlock x:Name="ColumnGroupHeading"
                                 Text="{Binding Heading}"
                                 Margin="0,4,0,0"
                                 IsVisible="{Binding #Root.((dash:TargetListViewModel)DataContext).ColumnPicker.ShowGroupHeadings}"
                                 Foreground="{DynamicResource ColorTextTertiary}" />
                      <ItemsControl ItemsSource="{Binding Columns}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="dash:ColumnViewModel">
                            <CheckBox Content="{Binding Title}"
                                      IsChecked="{Binding IsVisible, Mode=OneWay}"
                                      IsEnabled="{Binding CanHide}"
                                      Command="{Binding #Root.((dash:TargetListViewModel)DataContext).ToggleColumnCommand}"
                                      CommandParameter="{Binding}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Flyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
    </t:TableRow>

    <!-- The horizontal scroller is disabled, not hidden: a ScrollViewer that can scroll sideways
         measures its content at infinite width, so a star column inside one then resolves to its
         content's desired width rather than to the viewport, so nothing would ever give way and the
         scrollbar would be the only outcome. Disabled, the row is measured at the viewport and Name
         trims. Below the row's own minimum, about 680, the trimming has run out and the trailing
         cells clip rather than scroll; a scroller for that case alone would let the header, which
         sits outside it, drift out of line with the rows.

         The vertical bar is a table bar (spec.md item 8): always drawn and never auto-hidden, so it
         reserves its width and the rows end where the header's ScrollInset ends. -->
    <ScrollViewer Grid.Row="1"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Visible"
                  t:Table.Scroller="True">
      <!-- The refetch dim (spec 12.2, "The refetch dim", Phase 14C Task 4): while a filtered query
           is in flight, the rows already on screen stay rendered, dim and stop taking input; Load
           still replaces nothing until the new page lands, so the dim is the only signal this
           adds. IsHitTestVisible carries the input-disable half, not IsEnabled: an
           IsEnabled="False" subtree drops keyboard focus in Avalonia and never restores it, and the
           web's own treatment is pointer-events-none, a hit-test rule rather than a disablement.
           Classes.refetching carries the dim (ListBox.table.refetching in Theme/Table.axaml).
           t:Table.Scroller adds the table class, the zebra, and keeps the list's own (disabled)
           scroller from auto-hiding like any table host.

           One ListBox, one tab stop (ux-flow F8): Tab lands on the list once, Up and Down move the
           selection, Enter opens the selected target and Space opens or closes its nights. Those
           two keys are TargetListView.axaml.cs's, on the ListBoxItem only, so a key typed into a
           custom cell's editor inside a row stays that editor's. The panel is a plain StackPanel,
           as the ItemsControl's was, because the outer scroller already carries the rows and every
           row has to be realized for the shared size groups to measure the page. -->
      <ListBox x:Name="TargetListRows"
               t:Table.Scroller="True"
               ItemsSource="{Binding Rows}"
               SelectionMode="Single"
               Background="Transparent"
               BorderThickness="0"
               Padding="0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Disabled"
               AutomationProperties.Name="Targets"
               IsHitTestVisible="{Binding !IsRefetching}"
               Classes.refetching="{Binding IsRefetching}">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="dash:TargetRowViewModel">
            <!-- One zebra band per target, the night expander inside it under the cells. -->
            <StackPanel>
              <!-- The click target is a Button drawn under the cells rather than around them
                   (spec 12.2: clicking a row opens Target detail). A cell with no background of
                   its own is not hit tested, so a click anywhere in the row but on a badge reaches
                   the button.

                   It is a sibling of the row inside this Panel, not a cell of it, so it stretches
                   the whole row including the sessions column and takes part in no column at all:
                   inside the row it added about 20 pixels to the star share that the header did
                   not have (measured). What keeps a click on Nights off it is z-order alone: the
                   row is declared after the button and therefore paints and hit tests above it.

                   It is no longer taken out of the tab order. The ListBox around the rows is the
                   one tab stop (its TabNavigation is Once), so a row's buttons cost the page no
                   stops of their own, and the automation name is still the row's.

                   The context flyout is the row's right-click menu (ux-flow F9): Open is the same
                   command the click runs, Copy name puts the target's name on the clipboard. -->
              <Panel>
                <Panel.ContextFlyout>
                  <MenuFlyout>
                    <MenuItem Header="Open"
                              Command="{Binding #Root.((dash:TargetListViewModel)DataContext).OpenTargetCommand}"
                              CommandParameter="{Binding}" />
                    <MenuItem Header="Copy name"
                              Click="OnCopyNameClick" />
                  </MenuFlyout>
                </Panel.ContextFlyout>
                <Button x:Name="RowOpen"
                        Classes="tc-rowopen"
                        Command="{Binding #Root.((dash:TargetListViewModel)DataContext).OpenTargetCommand}"
                        CommandParameter="{Binding}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        AutomationProperties.Name="{Binding Name}"
                        MinHeight="0"
                        Padding="0" />

                <!-- The secondary ink is inherited from the row rather than set on each cell, so a
                     missing value's faint dash (a style) is not outranked by a local Foreground. -->
                <t:TableRow x:Name="TargetRowGrid"
                            Columns="{StaticResource TargetCols}"
                            TextElement.Foreground="{DynamicResource ColorTextSecondary}">
                  <!-- One line, name then common name on the same baseline (spec 12.2, "The Name
                       cell"), not a stacked subtitle. The name trims with an ellipsis; the common
                       name takes what is left and trims itself, so it cannot push the name out of
                       the cell. ClipToBounds is the belt: neither text can reach the Designation
                       column, which is what a name longer than the cell used to do on the 120
                       target fixture ("NGC 6960 - Veil Nebula,Filamentary Nebula,Western Veil"). -->
                  <DockPanel t:TableRow.Col="name"
                             x:Name="NameCell"
                             MaxWidth="{Binding #Root.NameCellMaxWidth}"
                             ClipToBounds="True"
                             ToolTip.Tip="{Binding Name}">
                    <!-- Spec 12.2's mosaic link (Phase 18, ruling R19): straight after the name and
                         before the common name, a drawn 2 by 2 tile glyph in the accent ink. It
                         sits above the row's own click target, so it opens the mosaic and never
                         the row's Target detail. Docked first, so the DockPanel measures it before
                         the name and the name trims into what is left: a long name can never push
                         the link past the cell's clip edge. -->
                    <DockPanel DockPanel.Dock="Left">
                      <Button DockPanel.Dock="Right"
                              x:Name="MosaicLink"
                              Classes="quiet"
                              Margin="4,0,0,0"
                              Padding="2"
                              VerticalAlignment="Center"
                              IsVisible="{Binding HasMosaic}"
                              ToolTip.Tip="{Binding MosaicTooltip}"
                              AutomationProperties.Name="{Binding MosaicTooltip}"
                              Command="{Binding #Root.((dash:TargetListViewModel)DataContext).OpenMosaicCommand}"
                              CommandParameter="{Binding}">
                        <Path Width="14" Height="14" Stroke="{DynamicResource ColorAccent}" StrokeThickness="1.4" Data="M1,1 h5 v5 h-5 z M8,1 h5 v5 h-5 z M1,8 h5 v5 h-5 z M8,8 h5 v5 h-5 z" />
                      </Button>
                      <TextBlock Text="{Binding Name}"
                                 VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis"
                                 Foreground="{DynamicResource ColorTextPrimary}" />
                    </DockPanel>
                    <TextBlock Text="{Binding CommonName}"
                               IsVisible="{Binding HasCommonName}"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                  </DockPanel>

                  <!-- Small muted mono, the web's designation: the caption tier in the secondary
                       ink (Theme/Table.axaml's tc-sub), never a local Foreground, so a missing
                       value's "-" still takes the faint ink. -->
                  <TextBlock t:TableRow.Col="designation"
                             x:Name="DesignationCell"
                             Classes="mono t-caption tc-sub"
                             Text="{Binding Designation}"
                             ToolTip.Tip="{Binding Designation}" />

                  <!-- One line of badges, never a WrapPanel: the wrap is what made the row two
                       lines high (user ruling U3 item 4). The column is shared and uncapped, so it
                       is as wide as the widest palette on the page and no badge is clipped and the
                       count is not capped (questions.md Q10). A target whose frames carry no
                       filter reads the faint dash instead of a silent blank (spec.md item 6). -->
                  <Panel t:TableRow.Col="palette">
                    <ItemsControl x:Name="PaletteCell"
                                  ItemsSource="{Binding PaletteBadges}"
                                  ItemTemplate="{StaticResource FilterBadgeTemplate}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock x:Name="PaletteMissing"
                               Text="{x:Static vmtd:MetricText.Missing}"
                               Foreground="{DynamicResource ColorTextTertiary}"
                               IsVisible="{Binding !PaletteBadges.Count}" />
                  </Panel>

                  <!-- Never "-" (a group with no frames reads 0.0), so it keeps the primary ink. -->
                  <TextBlock t:TableRow.Col="integration"
                             x:Name="IntegrationCell"
                             Text="{Binding IntegrationText}"
                             Foreground="{DynamicResource ColorTextPrimary}" />

                  <TextBlock t:TableRow.Col="equipment"
                             x:Name="EquipmentCell"
                             Text="{Binding EquipmentText}"
                             ToolTip.Tip="{Binding EquipmentText}" />

                  <TextBlock t:TableRow.Col="lastsession"
                             x:Name="LastSessionCell"
                             Text="{Binding LastSessionText}" />

                  <!-- Spec 12.15's target-scope cells, after Last session and before the sessions
                       control, in display order. Empty on an unresolved obj: group, which has no
                       target id to key a value by, and empty until the reader switches a column
                       on. -->
                  <ItemsControl t:TableRow.Col="custom"
                                x:Name="CustomCellStrip"
                                ItemsSource="{Binding CustomCells}"
                                ItemTemplate="{StaticResource TableCustomCell}" />

                  <!-- The sessions control, at the row's trailing end (spec 12.2, user ruling U3
                       item 3): the word Nights and a chevron that turns a quarter while the row is
                       open, with the session count on the tooltip rather than as a label beside the
                       name. Button.row, the tier for an action repeated on every row, so the column
                       of them recedes into the rows instead of reading as a column of boxes. -->
                  <Button t:TableRow.Col="sessions"
                          x:Name="SessionsToggle"
                          Classes="sm row"
                          HorizontalAlignment="Right"
                          Command="{Binding ToggleSessionsCommand}"
                          AutomationProperties.Name="{Binding SessionsToggleText}"
                          ToolTip.Tip="{Binding SessionsSummaryText}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="Nights" VerticalAlignment="Center" />
                      <Path Width="16" Height="16"
                            Classes="icon-glyph tc-disclosure"
                            Classes.open="{Binding IsExpanded}"
                            Data="{StaticResource IconChevronRight}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </t:TableRow>
              </Panel>

              <!-- The per-session lines, under a compact header of their own (ruling R15): the
                   figures carry no unit, so the header is what names them. Realized only while the
                   row is open: a collapsed row costs no session line controls. No Border and no
                   zebra of its own: the owning row's band and the indent carry the containment
                   (DESIGN.md section 8 refuses nested bordered containers). -->
              <StackPanel IsVisible="{Binding IsExpanded}" Margin="24,0,0,4">
                <t:TableRow Kind="Header" Columns="{StaticResource SessCols}">
                  <TextBlock t:TableRow.Col="date" Text="Date" />
                  <TextBlock t:TableRow.Col="frames" Text="{x:Static t:TableHeads.Frames}" />
                  <TextBlock t:TableRow.Col="hours" Text="{x:Static t:TableHeads.Hours}" />
                  <TextBlock t:TableRow.Col="filters" Text="Filters" />
                  <ItemsControl t:TableRow.Col="custom"
                                ItemsSource="{Binding SessionCustomHeadings}"
                                ItemTemplate="{StaticResource TableCustomHead}" />
                </t:TableRow>

                <ItemsControl x:Name="SessionsExpander" ItemsSource="{Binding Sessions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="dash:SessionRowViewModel">
                      <t:TableRow Columns="{StaticResource SessCols}"
                                  TextElement.Foreground="{DynamicResource ColorTextSecondary}">
                        <TextBlock t:TableRow.Col="date" Text="{Binding DateText}" />
                        <TextBlock t:TableRow.Col="frames" Text="{Binding FrameCountText}" />
                        <TextBlock t:TableRow.Col="hours" Text="{Binding IntegrationText}" />
                        <!-- The same filter badges the Palette column draws (spec 12.2), in
                             the same filter order. A night whose frames carry no filter reads
                             the faint dash, as the Palette cell does (spec.md item 6). -->
                        <Panel t:TableRow.Col="filters">
                          <ItemsControl x:Name="SessionFiltersCell"
                                        ItemsSource="{Binding Filters}"
                                        ItemTemplate="{StaticResource FilterBadgeTemplate}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                          </ItemsControl>
                          <TextBlock x:Name="SessionFiltersMissing"
                                     Text="{x:Static vmtd:MetricText.Missing}"
                                     Foreground="{DynamicResource ColorTextTertiary}"
                                     IsVisible="{Binding !Filters.Count}" />
                        </Panel>
                        <!-- Spec 12.15 amendment 2.4's session-scope cells. Ungated by any picker
                             (user choice 4), and read only when the row is expanded (ruling
                             C11), so the column measures nothing until then. -->
                        <ItemsControl t:TableRow.Col="custom"
                                      x:Name="SessionCustomCellStrip"
                                      ItemsSource="{Binding CustomCells}"
                                      ItemTemplate="{StaticResource TableCustomCell}" />

                        <!-- Spec 12.2's Deep dive action: the row's group key and this line's
                             own date, and nothing else (task6.md 6.3). Works identically for an
                             unresolved obj: group, whose GroupKey already carries that prefix. -->
                        <Button t:TableRow.Col="action"
                                x:Name="DeepDiveButton"
                                Content="Deep dive"
                                Classes="sm row"
                                Command="{Binding #Root.((dash:TargetListViewModel)DataContext).DeepDiveCommand}"
                                CommandParameter="{Binding}" />
                      </t:TableRow>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </ScrollViewer>
    </Grid>
    </Border>
  </Grid>
</UserControl>
